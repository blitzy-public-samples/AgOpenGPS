<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgIO.Views"
        x:Class="AgIO.Views.FormUDP"
        x:DataType="vm:FormUDPViewModel"
        Title="Ethernet Configuration"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Light"
        Background="#FFDCDCDC"
        Width="861"
        Height="584"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="Full"
        FontFamily="Tahoma"
        FontSize="14.25">

    <!-- [XPLAT] migrated from net48/WinForms FormUDP.cs + FormUDP.Designer.cs — see MIGRATION_DOCS/TRANSITION_MAP.md -->

    <!--
        [XPLAT] Avalonia 1:1 PARITY reimplementation of the deleted WinForms AgIO UDP / Ethernet
        scan-and-configure dialog (Forms/FormUDP.Designer.cs + FormUDP.cs + FormUDP.resx). Per AAP
        §0.3.3 this is a visual + behavioural PARITY reimplementation of the original Windows Forms
        look — never a redesign. No Figma was supplied (AAP §0.8); the rendered WinForms dialog is the
        sole visual reference.

        Compiled bindings (x:DataType="vm:FormUDPViewModel"; AgIO.csproj sets
        AvaloniaUseCompiledBindingsByDefault=true) to the migrated FormUDPViewModel, which replaced the
        WinForms "FormLoop mf" god-object back-reference with the injected CommCoordinatorService and
        surfaced the dialog's scan/subnet/monitor/restart/close actions as commands + events. Every
        binding path here resolves to a verified public member of FormUDPViewModel.

        Root-attribute parity mapping (WinForms FormUDP.Designer.cs -> Avalonia):
          • Form Text "Ethernet Configuration"     -> Title="Ethernet Configuration" (the original
                                                      title-bar caption; the agent-prompt's "UDP /
                                                      Ethernet" was an "e.g." suggestion — the real
                                                      caption is used for true parity).
          • ClientSize 861 x 584                    -> fixed Width="861" Height="584".
          • FormBorderStyle FixedDialog,            -> CanResize="False" + SystemDecorations="Full"
            MaximizeBox/MinimizeBox = false,           (a fixed, non-resizable dialog).
            ControlBox = false
          • BackColor Gainsboro                     -> Background="#FFDCDCDC" (GDI Color.Gainsboro).
          • StartPosition CenterParent              -> WindowStartupLocation="CenterOwner".
          • Font Tahoma 12 (controls up to 21.75)   -> base FontFamily="Tahoma" FontSize="14.25";
                                                      larger elements set FontSize explicitly below.
          • RequestedThemeVariant="Light"            -> AgIO is light-only (App.axaml pins Light); set
                                                      explicitly here for self-documentation.

        ASSETS — buttons render as TEXT (no System.Drawing, no avares:// imagery). The migrated
        AgIO.csproj registers NO btnImages as <AvaloniaResource> and excludes
        Properties/Resources.Designer.cs from compilation (no System.Drawing on either target
        framework). An avares://AgIO/btnImages/* reference here would NOT resolve and would render a
        broken image. Consistent with EVERY sibling migrated AgIO view (FormPGN, FormAdvancedSettings,
        FormISOBUS, FormSource, FormYes, FormProfiles, FormNumeric, FormKeyboard, FormEventViewer,
        FormRadioChannel), the WinForms image buttons (ScanNetwork / DeviceManager / EthernetOff /
        SubnetSend / OK64 / DnArrow64) and the now-redundant image-caption labels collapse to single
        text buttons that name their action.

        OCTETS — the three WinForms subnet NumericUpDowns (nudFirstIP / nudSecndIP / nudThirdIP) had
        their spinner buttons disabled and opened an on-screen keypad on tap (NumericUpDown.ShowKeypad).
        The migration replaced that with the Avalonia FormNumeric keypad dialog, invoked through the
        view-model's EditIp*Command + RequestKeypad callback (wired in the code-behind). They are
        therefore rendered here as large, touch-friendly tappable Buttons that DISPLAY the current octet
        ({Binding IpFirst/IpSecond/IpThird}) and raise the edit command on tap — exact behavioural
        parity (tap -> keypad), no <NumericUpDown> (none is used anywhere in the migrated AgIO views).

        MODULE TABLE order — reproduced top-to-bottom exactly as the WinForms tableLayoutPanel1 cell
        coordinates lay it out: IMU (row 0), Steer (row 1), GPS (row 2), Machine (row 3).

        DISMISSAL — the WinForms form had a single bottom-right close button (btnSerialCancel,
        DialogResult.Cancel). Following the sibling FormAdvancedSettings convention, an explicit
        Cancel + OK pair is provided (both bound to the view-model's CancelCommand / OkCommand, which
        both raise RequestClose); IsDefault maps Enter to OK and IsCancel maps Escape to Cancel.
    -->

    <!-- Light, large, touch-friendly styling reproducing the WinForms sizing (generous controls,
         bold captions). Avalonia Fluent (Light) is pinned application-wide in App.axaml. -->
    <Window.Styles>
        <!-- Command / action buttons: bold, comfortably above the 44x44 touch-target minimum. -->
        <Style Selector="Button.cmd">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextBlock.TextAlignment" Value="Center" />
        </Style>
        <!-- Subnet octet buttons: large bold numeric display (WinForms nud font was Tahoma 20.25 Bold). -->
        <Style Selector="Button.octet">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="102" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Background" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- The "." dotted separators between octets (WinForms label2 / label3, Tahoma 21.75 Bold). -->
        <Style Selector="TextBlock.dot">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Module-table cell frame (WinForms TableLayoutPanelCellBorderStyle.Single). -->
        <Style Selector="Border.cell">
            <Setter Property="BorderBrush" Value="#FFCCCCCC" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <!-- Module label cells (IMU / Steer / GPS / Machine), bold and centred. -->
        <Style Selector="TextBlock.modLabel">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Discovered module IP cells, bold (WinForms lbl*IP were Tahoma 15.75 Bold). -->
        <Style Selector="TextBlock.modIp">
            <Setter Property="FontSize" Value="15.75" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <!-- Three-column shell: left scan/diagnostics panel | centre scan results + subnet editor |
         right vertical command strip. Mirrors the WinForms layout (left NIC list, centre module
         table + subnet entry, far-right image-button column). -->
    <Grid Margin="12"
          ColumnDefinitions="280,*,156"
          ColumnSpacing="14">

        <!-- ============================================================================
             LEFT PANEL — Hostname (top), NIC diagnostic list (fill), interface filter
             (bottom). WinForms: label4 "Hostname:" + lblHostname; tboxNets multiline text
             box; label9 "Filter" + cboxUp toggle.
             ============================================================================ -->
        <DockPanel Grid.Column="0">

            <!-- WinForms label4 "Hostname:" + lblHostname (Gainsboro background) -> {Binding HostName}. -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,0,0,6">
                <TextBlock Text="Hostname:"
                           VerticalAlignment="Center" />
                <Border Background="#FFDCDCDC"
                        Padding="6,2">
                    <TextBlock x:Name="lblHostname"
                               Text="{Binding HostName}"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- WinForms label9 "Filter" + cboxUp (Appearance=Button toggling "Up" / "Up + Down").
                 Rendered as a text button bound to ToggleFilterUpCommand; the caption follows
                 {Binding FilterUpText}, exactly mirroring the original toggle text. -->
            <Grid DockPanel.Dock="Bottom"
                  ColumnDefinitions="Auto,*"
                  Margin="0,6,0,0">
                <TextBlock Grid.Column="0"
                           Text="Filter"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Button Grid.Column="1"
                        x:Name="cboxUp"
                        Classes="cmd"
                        HorizontalAlignment="Stretch"
                        Background="White"
                        Height="50"
                        Content="{Binding FilterUpText}"
                        Command="{Binding ToggleFilterUpCommand}" />
            </Grid>

            <!-- WinForms tboxNets: multiline, vertical-scroll, read-only diagnostic listing of the
                 local network interfaces (address / mask / status / packet counters), produced by the
                 scan. Bound read-only to {Binding NetsText}. Tahoma 12 Bold per the original. -->
            <TextBox x:Name="tboxNets"
                     Text="{Binding NetsText}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontSize="12"
                     FontWeight="Bold"
                     Background="White"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </DockPanel>

        <!-- ============================================================================
             CENTRE — module scan results (header + table), the discovered subnet readout,
             the Auto-Fill button, the new-subnet octet editor, the no-adapter warning, and
             the current-subnet readout.
             ============================================================================ -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto"
              RowSpacing="8">

            <!-- Row 0: WinForms label7 "Module Scan" + label11 "IP Address" column headers, plus an
                 explicit Scan affordance bound to ScanCommand (the VM exposes an on-demand scan; the
                 WinForms form scanned on load + on its 500 ms timer). -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,Auto,*">
                <TextBlock Grid.Column="0"
                           Text="Module Scan"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        x:Name="btnScan"
                        Classes="cmd"
                        Content="Scan"
                        MinWidth="84"
                        Height="40"
                        Margin="12,0,0,0"
                        Command="{Binding ScanCommand}" />
                <TextBlock Grid.Column="2"
                           Text="IP Address"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Row 1: WinForms tableLayoutPanel1 — a 3-column (module | IP | status light) x 4-row
                 (IMU / Steer / GPS / Machine) grid. Each status light's Background binds to the
                 view-model's per-module status brush (LimeGreen when the module is talking, Red when
                 silent — resolved from App.axaml's AogModuleOk/AlarmBrush). The "-"/".." placeholder
                 text the WinForms labels carried is replaced by the live discovered IP / a clean
                 colour-fill status light. -->
            <Border Grid.Row="1"
                    BorderBrush="#FF999999"
                    BorderThickness="1"
                    Background="White">
                <Grid ColumnDefinitions="95,*,40"
                      RowDefinitions="46,46,46,46">

                    <!-- Row 0 — IMU (WinForms label18 / lblIMU_IP / lblBtnIMU). -->
                    <Border Grid.Row="0" Grid.Column="0" Classes="cell">
                        <TextBlock Classes="modLabel" Text="IMU" />
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Classes="cell">
                        <TextBlock x:Name="lblIMU_IP" Classes="modIp" Text="{Binding ImuIpText}" />
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2"
                            x:Name="lblBtnIMU"
                            Classes="cell"
                            Background="{Binding ImuBrush}" />

                    <!-- Row 1 — Steer (WinForms label15 / lblSteerIP / lblBtnSteer). -->
                    <Border Grid.Row="1" Grid.Column="0" Classes="cell">
                        <TextBlock Classes="modLabel" Text="Steer" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Classes="cell">
                        <TextBlock x:Name="lblSteerIP" Classes="modIp" Text="{Binding SteerIpText}" />
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2"
                            x:Name="lblBtnSteer"
                            Classes="cell"
                            Background="{Binding SteerBrush}" />

                    <!-- Row 2 — GPS (WinForms label17 / lblGPSIP / lblBtnGPS). -->
                    <Border Grid.Row="2" Grid.Column="0" Classes="cell">
                        <TextBlock Classes="modLabel" Text="GPS" />
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Classes="cell">
                        <TextBlock x:Name="lblGPSIP" Classes="modIp" Text="{Binding GpsIpText}" />
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2"
                            x:Name="lblBtnGPS"
                            Classes="cell"
                            Background="{Binding GpsBrush}" />

                    <!-- Row 3 — Machine (WinForms label16 / lblMachineIP / lblBtnMachine). -->
                    <Border Grid.Row="3" Grid.Column="0" Classes="cell">
                        <TextBlock Classes="modLabel" Text="Machine" />
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" Classes="cell">
                        <TextBlock x:Name="lblMachineIP" Classes="modIp" Text="{Binding MachineIpText}" />
                    </Border>
                    <Border Grid.Row="3" Grid.Column="2"
                            x:Name="lblBtnMachine"
                            Classes="cell"
                            Background="{Binding MachineBrush}" />
                </Grid>
            </Border>

            <!-- Row 2: WinForms lblSubTimer ("Scanning" / "-" scan-cadence indicator) + lblNewSubnet
                 (the subnet a module last reported, Gainsboro readout). -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0"
                           x:Name="lblSubTimer"
                           Text="{Binding SubTimerText}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <Border Grid.Column="1"
                        Background="#FFDCDCDC"
                        BorderBrush="#FF808080"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        MinWidth="244"
                        Height="45">
                    <TextBlock x:Name="lblNewSubnet"
                               Text="{Binding NewSubnetText}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="8,0" />
                </Border>
            </Grid>

            <!-- Row 3: WinForms btnAutoSet "Auto Fill New Subnet" (DnArrow64 image + text). Bound to
                 AutoSetCommand, which auto-disables until a usable module scan reply arrives
                 (CanAutoSet gates the RelayCommand) — parity with the original btnAutoSet.Enabled. -->
            <Button Grid.Row="3"
                    x:Name="btnAutoSet"
                    Classes="cmd"
                    Content="Auto Fill New Subnet"
                    HorizontalAlignment="Left"
                    Width="222"
                    Height="56"
                    Background="#FFF5F5F5"
                    Command="{Binding AutoSetCommand}" />

            <!-- Row 4: WinForms label1 "Enter New Subnet Address". -->
            <TextBlock Grid.Row="4"
                       Text="Enter New Subnet Address"
                       HorizontalAlignment="Center" />

            <!-- Row 5: the new-subnet octet editor. Three tappable octet buttons (WinForms
                 nudFirstIP / nudSecndIP / nudThirdIP) separated by "." dots, the unsaved-change
                 indicator (WinForms pboxSendSteer; shown via IsSendIndicatorVisible), the Send-Subnet
                 button (WinForms btnSendSubnet, SubnetSend image), and the "Set Subnet" caption
                 (WinForms label8). Tapping an octet raises its EditIp*Command, which opens the
                 FormNumeric keypad through the view-model's RequestKeypad callback. -->
            <Grid Grid.Row="5"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto"
                  VerticalAlignment="Center">
                <Button Grid.Column="0"
                        x:Name="nudFirstIP"
                        Classes="octet"
                        Content="{Binding IpFirst}"
                        Command="{Binding EditIpFirstCommand}" />
                <TextBlock Grid.Column="1" Classes="dot" Text="." />
                <Button Grid.Column="2"
                        x:Name="nudSecndIP"
                        Classes="octet"
                        Content="{Binding IpSecond}"
                        Command="{Binding EditIpSecondCommand}" />
                <TextBlock Grid.Column="3" Classes="dot" Text="." />
                <Button Grid.Column="4"
                        x:Name="nudThirdIP"
                        Classes="octet"
                        Content="{Binding IpThird}"
                        Command="{Binding EditIpThirdCommand}" />

                <!-- WinForms pboxSendSteer (ConSt_Mandatory icon) — an "unsaved subnet change"
                     attention marker shown once an octet is edited or auto-filled, cleared after the
                     subnet is sent. Text glyph (no avares imagery on AgIO). -->
                <TextBlock Grid.Column="5"
                           x:Name="pboxSendSteer"
                           Text="!"
                           Foreground="#FFFF4500"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsSendIndicatorVisible}" />

                <Button Grid.Column="6"
                        x:Name="btnSendSubnet"
                        Classes="cmd"
                        Content="Send Subnet"
                        Height="64"
                        Margin="8,0,0,0"
                        Command="{Binding SendSubnetCommand}" />

                <TextBlock Grid.Column="8"
                           Text="Set Subnet"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>

            <!-- Row 6 (flexible spacer): WinForms lblNoAdapter "No Adapter For This Subnet" — the red
                 warning shown when no local adapter sits on the current module subnet
                 (IsNoAdapterVisible). Bottom-aligned so it sits just above the current-subnet readout. -->
            <TextBlock Grid.Row="6"
                       x:Name="lblNoAdapter"
                       Text="No Adapter For This Subnet"
                       Foreground="#FFFF0000"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,8,0,0"
                       IsVisible="{Binding IsNoAdapterVisible}" />

            <!-- Row 7: WinForms lblNetworkHelp (currently-saved module subnet, whose background turns
                 LightGreen when a local adapter is on that subnet and Salmon when none is —
                 NetworkHelpBrush) + label6 "Current Subnet". -->
            <StackPanel Grid.Row="7"
                        Spacing="2"
                        Margin="0,4,0,0">
                <Border Background="{Binding NetworkHelpBrush}"
                        HorizontalAlignment="Center"
                        MinWidth="279"
                        Height="46">
                    <TextBlock x:Name="lblNetworkHelp"
                               Text="{Binding NetworkHelpText}"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Current Subnet"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ============================================================================
             RIGHT STRIP — the WinForms far-right image-button column. Top group: Network
             Settings (Windows-only), UDP Off, UDP Monitor. Bottom group: Cancel + OK.
             ============================================================================ -->
        <DockPanel Grid.Column="2">

            <StackPanel DockPanel.Dock="Top"
                        Spacing="12">
                <!-- WinForms btnNetworkCPL (DeviceManager image, label12 "Network Prop") -> launches
                     the Windows Network Connections applet (ncpa.cpl). Windows-only: hidden off
                     Windows via IsVisible="{Binding IsWindows}" (the command is likewise gated). -->
                <Button x:Name="btnNetworkCPL"
                        Classes="cmd"
                        Content="Network Settings"
                        Height="64"
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsWindows}"
                        Command="{Binding OpenNetworkCplCommand}" />

                <!-- WinForms btnUDPOff (EthernetOff image, label5 "UDP Off") -> disables UDP features
                     and requests a restart. -->
                <Button x:Name="btnUDPOff"
                        Classes="cmd"
                        Content="UDP Off"
                        Height="64"
                        HorizontalAlignment="Stretch"
                        Command="{Binding UdpOffCommand}" />

                <!-- WinForms btnSerialMonitor (ScanNetwork image, label10 "UDP Monitor") -> asks the
                     host to open the UDP monitor dialog. -->
                <Button x:Name="btnSerialMonitor"
                        Classes="cmd"
                        Content="UDP Monitor"
                        Height="64"
                        HorizontalAlignment="Stretch"
                        Command="{Binding OpenMonitorCommand}" />
            </StackPanel>

            <!-- WinForms btnSerialCancel (the single bottom-right close button). Surfaced as an
                 explicit Cancel + OK pair per the sibling FormAdvancedSettings convention; both bound
                 to commands that raise the view-model's RequestClose. -->
            <StackPanel DockPanel.Dock="Bottom"
                        Spacing="12">
                <Button x:Name="btnCancel"
                        Classes="cmd"
                        Content="Cancel"
                        Height="64"
                        HorizontalAlignment="Stretch"
                        IsCancel="True"
                        Command="{Binding CancelCommand}" />
                <Button x:Name="btnSerialCancel"
                        Classes="cmd"
                        Content="OK"
                        Height="64"
                        HorizontalAlignment="Stretch"
                        IsDefault="True"
                        Command="{Binding OkCommand}" />
            </StackPanel>

            <!-- Filler so the top/bottom docked groups separate cleanly. -->
            <Border />
        </DockPanel>
    </Grid>
</Window>
