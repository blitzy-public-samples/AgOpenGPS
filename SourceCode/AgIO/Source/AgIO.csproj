<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- IPC-REFACTOR: retargeted net48 -> net8.0-windows (the #1 host-retarget deviation). Required so
         AgIO can host the Kestrel gRPC server (ASP.NET Core gRPC hosting needs .NET 6+); WinForms UI preserved. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PublishDir>..\..\..\AgOpenGPS\</PublishDir>
    <ApplicationIcon>AgIO_ico.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- IPC-REFACTOR: net8.0-windows retarget completion - enable WPF so System.Windows.Threading.Dispatcher
         (used by FormSerialMonitor) resolves via the Windows Desktop framework reference; on net48 it came
         from the implicit WindowsBase assembly. -->
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <!-- IPC-REFACTOR: suppress CS8981 ("type name 'glm' only contains lower-cased ascii characters").
         This warning is emitted ONLY by the newer C# language version that the net8.0-windows host retarget
         (the accepted #1 deviation) brings in; on the former net48 (C# 7.3) target it did not exist. Its sole
         source is the pre-existing, OUT-OF-SCOPE domain class Source\Classes\CGLM.cs (public static class glm),
         which the minimal-change discipline forbids modifying. Suppressing it at project scope restores the
         Release (warnings-as-errors) build viability the project had before the retarget, without touching
         unrelated domain code. Not IPC-related. -->
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <!-- IPC-REFACTOR: explicit WindowsBase reference removed - it is now supplied by <UseWPF>true</UseWPF>
         on net8.0-windows; keeping both caused an MSB3243 duplicate-assembly conflict. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AgLibrary\AgLibrary.csproj" />
    <ProjectReference Include="..\..\Keypad\Keypad.csproj" />
    <!-- IPC-REFACTOR: shared proto/gRPC contract + generated client AND server stubs + IpcConstants. -->
    <ProjectReference Include="..\..\AgOpenGPS.Ipc\AgOpenGPS.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.6.0" />
    <PackageReference Include="System.Resources.Extensions" Version="9.0.0" />
    <!-- IPC-REFACTOR: System.IO.Ports 8.0.0 is a FRAMEWORK-PARITY SHIM, NOT a new IPC/feature dependency, and is
         a direct, unavoidable consequence of the accepted #1 host-retarget deviation (AAP 0.1.3 / 0.6.4:
         net48 -> net8.0-windows so AgIO can host the Kestrel gRPC server). On net48 the hardware serial path
         (SerialComm / NTRIPComm / FormSerialMonitor) bound System.IO.Ports.SerialPort + SerialDataReceivedEventArgs
         from the built-in System.IO.Ports.dll; in .NET Core+ those types were removed from the shared framework and
         are shipped ONLY via this out-of-band package. It therefore adds no new capability — it restores the exact
         net48 SerialPort surface the out-of-scope hardware path already depends on. No in-framework alternative
         exists on net8.0. Version 8.0.0 matches the retarget's .NET 8 line; ADR-006 pinning is preserved. -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <!-- IPC-REFACTOR: gRPC server-hosting runtime (Grpc.AspNetCore) + build-time proto/gRPC codegen (Grpc.Tools). -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.81.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- IPC-REFACTOR: ASP.NET Core shared framework — provides Kestrel + gRPC server hosting for the AgIO TelemetryService/CommandService. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\Controls.Designer.cs">
      <DependentUpon>FormLoop.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\NMEA.Designer.cs">
      <DependentUpon>FormLoop.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\NTRIPComm.Designer.cs">
      <DependentUpon>FormLoop.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\SerialComm.Designer.cs">
      <DependentUpon>FormLoop.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\UDP.Designer.cs">
      <DependentUpon>FormLoop.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>