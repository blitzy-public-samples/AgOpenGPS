<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- IPC-REFACTOR: retargeted net48 -> net8.0-windows (the #1 host-retarget deviation). Required so
         AgIO can host the Kestrel gRPC server (ASP.NET Core gRPC hosting needs .NET 6+); WinForms UI preserved. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PublishDir>..\..\..\AgOpenGPS\</PublishDir>
    <ApplicationIcon>AgIO_ico.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- IPC-REFACTOR: net8.0-windows retarget completion - enable WPF so System.Windows.Threading.Dispatcher
         (used by FormSerialMonitor) resolves via the Windows Desktop framework reference; on net48 it came
         from the implicit WindowsBase assembly. -->
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <!-- IPC-REFACTOR: explicit WindowsBase reference removed - it is now supplied by <UseWPF>true</UseWPF>
         on net8.0-windows; keeping both caused an MSB3243 duplicate-assembly conflict. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AgLibrary\AgLibrary.csproj" />
    <ProjectReference Include="..\..\Keypad\Keypad.csproj" />
    <!-- IPC-REFACTOR: shared proto/gRPC contract + generated client AND server stubs + IpcConstants. -->
    <ProjectReference Include="..\..\AgOpenGPS.Ipc\AgOpenGPS.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.6.0" />
    <PackageReference Include="System.Resources.Extensions" Version="9.0.0" />
    <!-- IPC-REFACTOR: net8.0-windows retarget completion - SerialPort/SerialDataReceivedEventArgs left the
         shared framework in .NET Core+, so the hardware serial path (SerialComm/NTRIPComm/FormSerialMonitor)
         requires the out-of-band System.IO.Ports package. Not an IPC dependency; restores parity with net48. -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <!-- IPC-REFACTOR: gRPC server-hosting runtime (Grpc.AspNetCore) + build-time proto/gRPC codegen (Grpc.Tools). -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.81.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- IPC-REFACTOR: ASP.NET Core shared framework — provides Kestrel + gRPC server hosting for the AgIO TelemetryService/CommandService. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\Controls.Designer.cs">
      <DependentUpon>FormLoop.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\NMEA.Designer.cs">
      <DependentUpon>FormLoop.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\NTRIPComm.Designer.cs">
      <DependentUpon>FormLoop.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\SerialComm.Designer.cs">
      <DependentUpon>FormLoop.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\UDP.Designer.cs">
      <DependentUpon>FormLoop.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>