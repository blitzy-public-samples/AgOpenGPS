<Project Sdk="Microsoft.NET.Sdk">
  <!-- [XPLAT] migrated from net48/WinForms — see MIGRATION_DOCS/TRANSITION_MAP.md -->

  <PropertyGroup>
    <!-- [XPLAT] Exe (not WinExe) so the Avalonia app launches as a normal cross-platform
         process; Avalonia owns its windowing/message loop. Matches the sibling migrated
         Avalonia apps (ModSim/GPS_Out/AgDiag), which also use Exe. -->
    <OutputType>Exe</OutputType>
    <!-- [XPLAT] Multi-target (AAP §0.3.2 / migration plan Phase 1). Directory.Build.props sets a
         SINGULAR <TargetFramework>net8.0</TargetFramework>; MSBuild only honors the plural
         <TargetFrameworks> when the singular is blank, so the empty element below overrides the
         inherited value. The net8.0 head is the cross-platform (Windows/Linux/macOS) build; the
         net8.0-windows head additionally compiles the Windows-only one-time legacy-Registry
         migration-read — Properties/RegistrySettings.cs (MigrateFromRegistry) and
         Services/WindowsPlatformServices.cs (ReadLegacyRegistryConfig), both fenced behind
         #if WINDOWS using Microsoft.Win32.Registry. The SDK auto-defines the WINDOWS compilation
         symbol for the net8.0-windows TFM (verified), so no manual <DefineConstants> is needed and
         Microsoft.Win32.Registry resolves without an extra package. At publish the CI matrix pairs
         win-x64 with net8.0-windows and linux-x64/osx-x64/osx-arm64 with net8.0 via -f/-r. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <PublishDir>..\..\..\AgOpenGPS\</PublishDir>
    <ApplicationIcon>AgIO_ico.ico</ApplicationIcon>
    <!-- [XPLAT] Multi-targeting requires the TFM in the output path so the net8.0 and
         net8.0-windows build outputs do not collide (AgIO is a leaf executable — nothing
         references its build output — so this is safe). -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!-- [XPLAT] compiled XAML + generated typed x:Name fields for the Views/*.axaml code-behind -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- [XPLAT] per-OS self-contained publish targets for the tri-OS CI matrix (Windows/Linux/macOS) -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- [XPLAT] Avalonia cross-platform UI stack (replaces WinForms); all packages share one version -->
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <!-- [XPLAT] developer diagnostics overlay; Debug builds only -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)' == 'Debug'" />
    <!-- [XPLAT] cross-platform serial communication (COMx on Windows; /dev/ttyUSB*, /dev/ttyACM*
         on Linux; /dev/cu.* on macOS). In-box on net48; supplied by this package on net8.0.
         Port-name enumeration is wrapped by SerialCommService.GetAvailablePortNames(). -->
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- [XPLAT] AgLibrary: logging + XmlSettingsHandler (cross-platform settings backing — AgIO
         persists via AgLibrary.Settings, NOT System.Configuration, so ConfigurationManager is not referenced).
         Keypad: Avalonia on-screen keyboard/keypad UserControls. AgOpenGPS.Core: portable view-model base
         (AgOpenGPS.Core.ViewModels.ViewModel) used by the Form*ViewModel classes. -->
    <ProjectReference Include="..\..\AgLibrary\AgLibrary.csproj" />
    <ProjectReference Include="..\..\Keypad\Keypad.csproj" />
    <ProjectReference Include="..\..\AgOpenGPS.Core\AgOpenGPS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- [XPLAT] Properties/Resources.Designer.cs is the retained net48 StronglyTypedResourceBuilder
         accessor; its 165 members return System.Drawing.Bitmap. AgIO was re-platformed to a
         cross-platform Avalonia project (multi-targeting net8.0 + net8.0-windows; UseWindowsForms and
         the System.Drawing reference were removed), and the migration introduces no
         System.Drawing.Common / GDI+ dependency on EITHER target framework (see the convention
         documented in AgLibrary.csproj). The Avalonia views load their imagery via Avalonia assets,
         so this generated accessor is unused. It is retained in source control for provenance but
         excluded from compilation so AgIO builds on Windows, Linux, and macOS. -->
    <Compile Remove="Properties\Resources.Designer.cs" />

    <!-- [XPLAT] Services/CommCoordinatorService.cs is the AAP §0.3.2 "Facade" comms aggregate intended
         to own and wire the four extracted comm services (Udp/Nmea/Serial/Ntrip) for the AgIO
         composition root. It is complete but not yet adopted: at this checkpoint Views/MainWindow.axaml.cs
         is the composition root and constructs/wires those four services directly (plus its own scan
         timer), so the coordinator currently has no caller. To avoid a dead parallel orchestration path
         (review finding AGIO-1), it is explicitly DEFERRED here — excluded from compilation, retained in
         source control for provenance — until the checkpoint that re-points the AgIO composition root
         onto the facade. It has zero references elsewhere (verified), so excluding it is behaviour-neutral:
         the loopback/NTRIP/scan comm behaviour MainWindow already provides is unchanged. -->
    <Compile Remove="Services\CommCoordinatorService.cs" />
  </ItemGroup>

</Project>
