<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- IPC-REFACTOR: retargeted net48 -> net8.0-windows (consequence of the AAP 0.1.3 / 0.6.4 #1 host-retarget
         deviation). AgDiag is a passive-observer gRPC CLIENT; on netstandard2.0 (net48) the loopback UDS/named-pipe
         HTTP/2 transport cannot be built (SocketsHttpHandler.ConnectCallback is .NET 6+ only), so the migrated IPC
         subscription could not connect at runtime. Retargeting to net8.0-windows makes AgDiag consume the .NET 8
         AgOpenGPS.Ipc target and its fully functional ConnectCallback transport. AgDiag is a leaf WinExe (nothing
         references it) and references only AgOpenGPS.Ipc, so the retarget is isolated. WinForms UI is preserved. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PublishDir>..\..\AgOpenGPS\</PublishDir>
    <ApplicationIcon>AgDiag.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- IPC-REFACTOR: explicit net48 <Reference Include="System.Configuration" /> removed — on net8.0-windows the
         System.Configuration namespace (Properties\Settings.Designer.cs uses ApplicationSettingsBase) is supplied
         by the Windows Desktop shared framework; keeping the explicit net48 reference assembly caused an MSB3243
         duplicate-assembly conflict warning. -->
    <PackageReference Include="System.Memory" Version="4.6.0" />
    <PackageReference Include="System.Resources.Extensions" Version="9.0.0" />
    <!-- IPC-REFACTOR: gRPC client runtime for AgDiag passive-observer subscription to TelemetryService. -->
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
  </ItemGroup>

  <!-- IPC-REFACTOR: shared proto/gRPC contract + generated client stubs + IpcConstants. -->
  <ItemGroup>
    <ProjectReference Include="..\AgOpenGPS.Ipc\AgOpenGPS.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>