<Project Sdk="Microsoft.NET.Sdk">
  <!-- [XPLAT] migrated from net48/WinForms — see MIGRATION_DOCS/TRANSITION_MAP.md -->

  <PropertyGroup>
    <!-- [XPLAT] Exe (not WinExe) so the Avalonia app launches as a normal cross-platform
         process; Avalonia owns its windowing/message loop. -->
    <OutputType>Exe</OutputType>
    <PublishDir>..\..\..\AgOpenGPS\</PublishDir>
    <ApplicationIcon>satellite.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- [XPLAT] compiled XAML + generated typed x:Name fields for the Views/*.axaml code-behind -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- [XPLAT] per-OS self-contained publish targets for the tri-OS CI matrix (Windows/Linux/macOS) -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- [XPLAT] Avalonia cross-platform UI stack (replaces WinForms); all packages share one version -->
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <!-- [XPLAT] developer diagnostics overlay; Debug builds only -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)' == 'Debug'" />
    <!-- [XPLAT] cross-platform serial communication (COMx on Windows; /dev/ttyUSB*, /dev/ttyACM*
         on Linux; /dev/cu.* on macOS). In-box on net48; supplied by this package on net8.0.
         Port-name enumeration is wrapped by the internal SerialPortHelper. -->
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <!-- [XPLAT] cross-platform backing for the retained ApplicationSettingsBase persistence
         (Properties/Settings.Designer.cs). In-box on net48; supplied by this package on net8.0.
         The WinForms-only Properties/Resources.resx (System.Drawing.Bitmap-typed On/Off/ScanPorts
         entries) was removed; those images are now served as AvaloniaResource (avares://). -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- [XPLAT] port-light + rescan glyphs served to Avalonia Image controls via avares:// URIs -->
    <AvaloniaResource Include="Resources\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
