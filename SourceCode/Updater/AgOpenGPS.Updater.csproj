<Project Sdk="Microsoft.NET.Sdk">
  <!-- [XPLAT] migrated from net48/WinForms — see MIGRATION_DOCS/TRANSITION_MAP.md -->

  <PropertyGroup>
    <!-- [XPLAT] Exe (not WinExe) so the Avalonia updater launches as a normal cross-platform
         process; Avalonia owns its windowing/message loop. TargetFramework is inherited from
         SourceCode/Directory.Build.props (net8.0) — the explicit net48 was removed. -->
    <OutputType>Exe</OutputType>
    <!-- [XPLAT] per-OS self-contained publish targets for the tri-OS CI matrix (Windows/Linux/macOS);
         replaces the single win-x64 RuntimeIdentifier. -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PublishDir>..\..\AgOpenGPS\</PublishDir>
    <ApplicationIcon>AOG.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- [XPLAT] compiled XAML + generated typed x:Name fields for the Forms/*.axaml code-behind -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>AgOpenGPS.Updater</RootNamespace>
    <AssemblyName>AgOpenGPS.Updater</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>AgOpenGPS</Authors>
    <Company>AgOpenGPS</Company>
    <Product>AgOpenGPS Updater</Product>
    <Description>Automatic updater for AgOpenGPS</Description>
    <Copyright>Copyright © AgOpenGPS 2024</Copyright>
    <Title>AgOpenGPS Updater</Title>
    <!-- Don't auto-generate assembly info since we define it in Properties/AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- [XPLAT] Avalonia cross-platform UI stack (replaces WinForms); all packages share one version -->
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <!-- [XPLAT] developer diagnostics overlay; Debug builds only -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)' == 'Debug'" />
    <!-- GitHub release JSON (de)serialization — unchanged from the net48 updater. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- GPLv3 license text carried unchanged (AAP §0.2.3 — license artifacts retained). -->
    <Content Include="License.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
