<!-- [XPLAT] migrated from net48/WinForms — see MIGRATION_DOCS/TRANSITION_MAP.md -->
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    [XPLAT] Keypad is now a portable Avalonia UserControl library.
      * Removed UseWindowsForms / ImportWindowsDesktopTargets: the on-screen keypads
        (GenericKeypad base + NumKeypad + Keyboard) are Avalonia UserControls now.
      * Removed System.Memory (net48 polyfill; in-box on net8.0) and the
        System.Resources.Extensions + GenerateResourceUsePreserializedResources WinForms
        .resx pipeline (the deleted Properties/Resources.resx is replaced by AvaloniaResource
        PNGs referenced directly by avares:// URIs).
      * Button glyph images live under Resources/ and are embedded as AvaloniaResource.
    TargetFramework (net8.0) is inherited from SourceCode/Directory.Build.props.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
  </ItemGroup>

  <ItemGroup>
    <!-- [XPLAT] Keypad button glyphs, addressed as avares://Keypad/Resources/<name>.png. -->
    <AvaloniaResource Include="Resources/**" />
  </ItemGroup>

</Project>
