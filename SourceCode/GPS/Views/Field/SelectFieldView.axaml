<!-- [XPLAT] migrated from net48/WinForms — see MIGRATION_DOCS/TRANSITION_MAP.md -->
<!--
    [XPLAT] AgOpenGPS (GPS program) — Select-Field dialog (full field table) Avalonia view.

    NET-NEW Avalonia MVVM view (discipline A — compiled-binding MVVM); there was no WinForms source
    form. It is one of the four Select-Field dialogs and shows the FULL field table (all fields),
    offering Open (load the selected field), Delete (delete the selected field) and Cancel. It mirrors
    the Core view-model surface AgOpenGPS.Core.ViewModels.SelectFieldViewModel
    (: FieldTableViewModel — inherits the table/sort surface and adds DeleteFieldCommand). Structurally
    identical to the sibling SelectNearFieldView (same sort toggle + column headers + list), with the
    addition of the Delete button. Per AAP §0.3.3 this is a 1:1 visual PARITY reimplementation of the
    current Windows Forms look — never a redesign: no new colours, no relayout, no UX changes.

    Wiring contract (do NOT change here):
      * The DataContext is assigned EXTERNALLY by AvaloniaSelectFieldPanelPresenter via
        `new SelectFieldView { DataContext = vm }` and shown with Show/ShowDialog/Close. Therefore this
        markup sets NO DataContext and NO Design.DataContext — the view-model has only a 4-argument
        constructor (no parameterless ctor), so a design-time instance cannot be created. `x:DataType`
        below only declares the type for compile-time binding checking; it never instantiates the VM.
      * `x:CompileBindings="True"` makes every {Binding ...} a compiled binding resolved against
        SelectFieldViewModel (and, inside the row template, FieldDescriptionViewModel) at build time, so
        a misspelled path fails the build (Release treats warnings as errors). Bound members:
        FieldDescriptionViewModels, LocalSelectedField, SelectFieldCommand, NextSortModeCommand,
        DeleteFieldCommand, ByNameVisible / ByDistanceVisible / ByAreaVisible, and per row
        FieldName / DistanceViewModel.DisplayedDistance / AreaViewModel.DisplayedArea.
      * btnCancel carries an x:Name so the partner code-behind (SelectFieldView.axaml.cs) wires its
        Click to Close(). Open is driven entirely by SelectFieldCommand and Delete by DeleteFieldCommand
        — the VM's DeleteField() itself raises the confirm message box through the presenter
        (ShowConfirmDeleteMessageBox) and refreshes the list, so this view adds NO confirm dialog.

    Theme (per AAP §0.3.3 — 1:1 visual parity):
      All colours come from the day/night theme brushes defined in App.axaml's ThemeDictionaries and are
      referenced via {DynamicResource ...} so the live Light<->Dark switch is observed. No hardcoded
      colours. Button glyphs are served from the GPS assembly (assembly name "AgOpenGPS") via
      avares://AgOpenGPS/btnImages/<name>.png — the avares:// convention used by every sibling GPS view.
      No converters and no WinForms/WPF xmlns are used (Avalonia 11.3 compiled-binding markup only).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgOpenGPS.Core.ViewModels;assembly=AgOpenGPS.Core"
        x:Class="AgOpenGPS.Views.Field.SelectFieldView"
        x:DataType="vm:SelectFieldViewModel"
        x:CompileBindings="True"
        Title="Select Field"
        Width="660" Height="540"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AogFrameBrush}">

    <!--
        Three logical bands via DockPanel (LastChildFill defaults to true so the list fills the centre):
          Top    — the sort-mode toggle plus the static column headers.
          Bottom — the right-aligned Delete / Open / Cancel command buttons.
          Centre — the field list (last child, stretches to fill the remaining space).
    -->
    <DockPanel Margin="12">

        <!--
            TOP band — sort header.
            (a) A single toggle button bound to NextSortModeCommand cycles the sort order
                Name -> Distance -> Area; exactly one of the three chips is visible at a time
                (ByNameVisible / ByDistanceVisible / ByAreaVisible are mutually-exclusive bools on the
                VM, so IsVisible binds straight to them — no converter). The button therefore always
                shows the active sort field and changes it on tap.
            (b) Static column headers aligned to the list's three columns below (Field | Distance | Area).
        -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">

            <Button Command="{Binding NextSortModeCommand}"
                    HorizontalAlignment="Left"
                    MinHeight="44"
                    MinWidth="140"
                    AutomationProperties.Name="Change field sort order"
                    Foreground="{DynamicResource AogTextBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Sort:"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AogTextBrush}" />
                    <TextBlock Text="Name"
                               IsVisible="{Binding ByNameVisible}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AogTextBrush}" />
                    <TextBlock Text="Distance"
                               IsVisible="{Binding ByDistanceVisible}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AogTextBrush}" />
                    <TextBlock Text="Area"
                               IsVisible="{Binding ByAreaVisible}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AogTextBrush}" />
                </StackPanel>
            </Button>

            <!-- Static column headers; ColumnDefinitions match the row template so the columns align.
                 The modest horizontal margin offsets the ListBox border + ListBoxItem padding below. -->
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="10,6,10,2">
                <TextBlock Grid.Column="0"
                           Text="Field"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AogTextBrush}" />
                <TextBlock Grid.Column="1"
                           Width="120"
                           Text="Distance"
                           TextAlignment="Right"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AogTextBrush}" />
                <TextBlock Grid.Column="2"
                           Width="120"
                           Text="Area"
                           TextAlignment="Right"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AogTextBrush}" />
            </Grid>
        </StackPanel>

        <!--
            BOTTOM band — command buttons, right-aligned, in the order Delete | Open | Cancel
            (Delete sits to the LEFT of Open/Cancel). Each is a large touch target (MinHeight 56,
            MinWidth 120) carrying a glyph plus caption.
        -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,8,0,0">

            <!-- Delete the selected field. The VM confirms (ShowConfirmDeleteMessageBox) and refreshes
                 the list itself, so NO confirm dialog is added here. -->
            <Button Command="{Binding DeleteFieldCommand}"
                    MinHeight="56"
                    MinWidth="120"
                    AutomationProperties.Name="Delete"
                    Foreground="{DynamicResource AogTextBrush}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="avares://AgOpenGPS/btnImages/Trash.png"
                           Width="32"
                           Height="32" />
                    <TextBlock Text="Delete"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
            </Button>

            <!-- Open (load) the selected field. -->
            <Button Command="{Binding SelectFieldCommand}"
                    MinHeight="56"
                    MinWidth="120"
                    AutomationProperties.Name="Open"
                    Foreground="{DynamicResource AogTextBrush}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="avares://AgOpenGPS/btnImages/OK64.png"
                           Width="32"
                           Height="32" />
                    <TextBlock Text="Open"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
            </Button>

            <!-- Cancel — closed by the code-behind (SelectFieldView.axaml.cs) Click handler -> Close(). -->
            <Button x:Name="btnCancel"
                    IsCancel="True"
                    MinHeight="56"
                    MinWidth="120"
                    AutomationProperties.Name="Cancel"
                    Foreground="{DynamicResource AogTextBrush}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="avares://AgOpenGPS/btnImages/Cancel64.png"
                           Width="32"
                           Height="32" />
                    <TextBlock Text="Cancel"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--
            CENTRE — the field list (last child, fills the remaining space). ItemsSource is the VM's
            field collection; the selected row is two-way bound to LocalSelectedField so the Open/Delete
            commands act on it. Each row is a three-column grid (name | distance | area); FallbackValue=''
            guards the cells whose DistanceViewModel / AreaViewModel may be null (a field with no start
            position has no distance; one with no recorded area has no area).
        -->
        <ListBox ItemsSource="{Binding FieldDescriptionViewModels}"
                 SelectedItem="{Binding LocalSelectedField, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!-- Stretch each row full width so the three columns align with the headers above and the
                 selection highlight spans the whole row. Setters only — no bindings. -->
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,4" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:FieldDescriptionViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding FieldName}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AogTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Width="120"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AogTextBrush}"
                                   Text="{Binding DistanceViewModel.DisplayedDistance, StringFormat='{}{0:0.000}', FallbackValue=''}" />
                        <TextBlock Grid.Column="2"
                                   Width="120"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AogTextBrush}"
                                   Text="{Binding AreaViewModel.DisplayedArea, StringFormat='{}{0:0.0}', FallbackValue=''}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
