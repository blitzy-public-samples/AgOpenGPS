<!-- [XPLAT] migrated from net48/WinForms FormConfig (folds ConfigMenu/Vehicle/Tool/Data/Module/Help partials) — see TRANSITION_MAP.md -->
<!--
    [XPLAT] AgOpenGPS (GPS program) — Configuration dialog (Avalonia view).

    1:1 PARITY reimplementation that FOLDS the 8 WinForms partial-class files of the legacy
    Forms/Settings/FormConfig (FormConfig.cs + FormConfig.Designer.cs + ConfigMenu/ConfigVehicle/
    ConfigTool/ConfigData/ConfigModule/ConfigHelp .Designer.cs) into ONE multi-section Avalonia
    view per AAP §0.3.3. Every control name, position and size below is taken verbatim from
    FormConfig.Designer.cs (ClientSize 995x715; the authoritative control inventory).

    IMPERATIVE / code-behind-driven (NO x:DataType, NO DataContext, NO MVVM binding): the
    companion FormConfigView.axaml.cs reproduces the WinForms designer / Enter-Leave load-save
    lifecycle, the sidebar nav routing (ShowSubMenu / HideSubMenu), the GradientActive/Inactive
    sidebar highlight, the metric FixMinMaxSpinners transform and the nud->FormNumeric keypad.
    It addresses every control by the exact x:Name declared here — those names are a HARD
    CONTRACT. No {Binding} is used (AvaloniaUseCompiledBindingsByDefault=true + no x:DataType);
    only static values and theme {DynamicResource} brushes appear.

    SHELL PARITY (FormConfig.Designer.cs): ClientSize 995x715 -> Width/Height; ControlBox=false +
    FixedDialog (non-resizable) -> SystemDecorations="None" + CanResize="False"; StartPosition
    CenterScreen -> WindowStartupLocation="CenterOwner" (shown modally over FormGPS); not in
    taskbar -> ShowInTaskbar="False". Background/foreground/accent follow the App.axaml day/night
    theme (AogFrameBrush / AogTextBrush / AogAccentBrush).

    LAYOUT: a left navigation sidebar (panelLeftSideMenu) + a central content TabControl (tab1)
    whose header strip is hidden (WinForms tab1 had Appearance=FlatButtons, ItemSize=(0,1),
    SizeMode=Fixed — invisible headers; navigation is driven entirely by the sidebar buttons) +
    a bottom strip (panelBottom) carrying the global OK button and the live unit/width readouts.
    Per-tab controls are laid out on a Canvas using the WinForms absolute coordinates for parity.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cfg="using:AgOpenGPS.Views.Config"
        x:Class="AgOpenGPS.Views.Settings.FormConfigView"
        Title="Configuration"
        Width="995" Height="715"
        CanResize="False"
        SystemDecorations="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AogFrameBrush}"
        Foreground="{DynamicResource AogTextBrush}"
        FontFamily="Tahoma"
        FontSize="13">

    <Window.Styles>
        <!-- Hide the tab1 header strip: navigation is via the sidebar (WinForms ItemSize=(0,1)). -->
        <Style Selector="TabControl#tab1 /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TabControl#tab1">
            <Setter Property="Padding" Value="0" />
        </Style>
        <!-- Labels follow the day/night theme text colour. -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AogTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.groupHeader">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AogTextBrush}" />
        </Style>
        <!-- GroupBox -> bordered Border with a header TextBlock (HeaderedContentControl analogue). -->
        <Style Selector="Border.groupbox">
            <Setter Property="BorderBrush" Value="{DynamicResource AogAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- NudlessNumericUpDown -> bordered numeric-entry button (opens FormNumeric keypad). -->
        <Style Selector="Button.numeric">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Flat image-only push buttons (FlatStyle.Flat, transparent). -->
        <Style Selector="Button.flatImage">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="RepeatButton.flatImage">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <!-- Image-toggle CheckBoxes/RadioButtons (WinForms Appearance.Button): flat bordered tile,
             Background turns MediumAquamarine when :checked (FlatAppearance.CheckedBackColor). -->
        <Style Selector="CheckBox.imageToggle">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.imageToggle:checked">
            <Setter Property="Background" Value="MediumAquamarine" />
        </Style>
        <Style Selector="RadioButton.imageToggle">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.imageToggle:checked">
            <Setter Property="Background" Value="MediumAquamarine" />
        </Style>
        <!-- Sidebar navigation buttons (icon tiles; code-behind sets the active/inactive highlight). -->
        <Style Selector="Button.navButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AogAccentBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.navSubButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <!-- Fixed 995 x 715 client; absolute positioning for 1:1 parity with FormConfig.Designer.cs. -->
    <Canvas Width="995" Height="715">

        <!-- ===================== LEFT NAVIGATION SIDEBAR (panelLeftSideMenu) =====================
             8 primary category buttons; 4 collapsible sub-menu panels (IsVisible="False" initially,
             toggled by the code-behind ShowSubMenu/HideSubMenu). WinForms used fixed-offset toggled
             panels; per AAP this is the equivalent reflow StackPanel. -->
        <Border x:Name="panelLeftSideMenu" Canvas.Left="4" Canvas.Top="4" Width="120" Height="707"
                Background="{DynamicResource AogFrameBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <Button x:Name="btnVehicle" Classes="navButton" MinHeight="64" AutomationProperties.Name="Vehicle">
                    <Image Source="avares://AgOpenGPS/btnImages/Config/Con_VehicleMenu.png" Stretch="Uniform" Height="40" />
                </Button>
                    <StackPanel x:Name="panelVehicleSubMenu" IsVisible="False">
                    <Button x:Name="btnSubVehicleType" Classes="navSubButton" MinHeight="50" AutomationProperties.Name="Sub Vehicle Type">
                        <Image Source="avares://AgOpenGPS/btnImages/Config/ConS_VehicleConfig.png" Stretch="Uniform" Height="32" />
                    </Button>
                    <Button x:Name="btnSubDimensions" Classes="navSubButton" MinHeight="50" AutomationProperties.Name="Sub Dimensions">
                        <Image Source="avares://AgOpenGPS/btnImages/Config/ConS_ImplementHitch.png" Stretch="Uniform" Height="32" />
                    </Button>
                    <Button x:Name="btnSubAntenna" Classes="navSubButton" MinHeight="50" AutomationProperties.Name="Sub Antenna">
                        <Image Source="avares://AgOpenGPS/btnImages/Config/ConS_ImplementAntenna.png" Stretch="Uniform" Height="32" />
                    </Button>
                    <Button x:Name="btnSubGuidance" Classes="navSubButton" MinHeight="50" Content="Sub Guidance" AutomationProperties.Name="Sub Guidance" />
                    </StackPanel>
                <Button x:Name="btnTool" Classes="navButton" MinHeight="64" AutomationProperties.Name="Tool">
                    <Image Source="avares://AgOpenGPS/btnImages/Config/Con_ImplementMenu.png" Stretch="Uniform" Height="40" />
                </Button>
                    <StackPanel x:Name="panelToolSubMenu" IsVisible="False">
                    <Button x:Name="btnSubToolType" Classes="navSubButton" MinHeight="50" AutomationProperties.Name="Sub Tool Type">
                        <Image Source="avares://AgOpenGPS/btnImages/Config/ConS_ImplementConfig.png" Stretch="Uniform" Height="32" />
                    </Button>
                    <Button x:Name="btnSubHitch" Classes="navSubButton" MinHeight="50" AutomationProperties.Name="Sub Hitch">
                        <Image Source="avares://AgOpenGPS/btnImages/Config/ConS_ImplementHitch.png" Stretch="Uniform" Height="32" />
                    </Button>
                    <Button x:Name="btnSubToolOffset" Classes="navSubButton" MinHeight="50" AutomationProperties.Name="Sub Tool Offset">
                        <Image Source="avares://AgOpenGPS/btnImages/Config/ConS_ImplementOffset.png" Stretch="Uniform" Height="32" />
                    </Button>
                    <Button x:Name="btnSubPivot" Classes="navSubButton" MinHeight="50" AutomationProperties.Name="Sub Pivot">
                        <Image Source="avares://AgOpenGPS/btnImages/Config/ConS_ImplementPivot.png" Stretch="Uniform" Height="32" />
                    </Button>
                    <Button x:Name="btnSubSections" Classes="navSubButton" MinHeight="50" AutomationProperties.Name="Sub Sections">
                        <Image Source="avares://AgOpenGPS/btnImages/Config/ConS_ImplementSection.png" Stretch="Uniform" Height="32" />
                    </Button>
                    <Button x:Name="btnSubSwitches" Classes="navSubButton" MinHeight="50" AutomationProperties.Name="Sub Switches">
                        <Image Source="avares://AgOpenGPS/btnImages/Config/ConS_ImplementSwitch.png" Stretch="Uniform" Height="32" />
                    </Button>
                    <Button x:Name="btnSubToolSettings" Classes="navSubButton" MinHeight="50" AutomationProperties.Name="Sub Tool Settings">
                        <Image Source="avares://AgOpenGPS/btnImages/Config/ConS_ImplementSettings.png" Stretch="Uniform" Height="32" />
                    </Button>
                    </StackPanel>
                <Button x:Name="btnDataSources" Classes="navButton" MinHeight="64" AutomationProperties.Name="Data Sources">
                    <Image Source="avares://AgOpenGPS/btnImages/Config/Con_SourcesMenu.png" Stretch="Uniform" Height="40" />
                </Button>
                    <StackPanel x:Name="panelDataSourcesSubMenu" IsVisible="False">
                    <Button x:Name="btnSubHeading" Classes="navSubButton" MinHeight="50" AutomationProperties.Name="Sub Heading">
                        <Image Source="avares://AgOpenGPS/btnImages/Config/ConS_SourcesHeading.png" Stretch="Uniform" Height="32" />
                    </Button>
                    <Button x:Name="btnSubRoll" Classes="navSubButton" MinHeight="50" AutomationProperties.Name="Sub Roll">
                        <Image Source="avares://AgOpenGPS/btnImages/Config/ConS_SourcesRoll.png" Stretch="Uniform" Height="32" />
                    </Button>
                    </StackPanel>
                <Button x:Name="btnArduino" Classes="navButton" MinHeight="64" AutomationProperties.Name="Arduino">
                    <Image Source="avares://AgOpenGPS/btnImages/Config/Con_ModulesMenu.png" Stretch="Uniform" Height="40" />
                </Button>
                    <StackPanel x:Name="panelArduinoSubMenu" IsVisible="False">
                    <Button x:Name="btnMachineModule" Classes="navSubButton" MinHeight="50" AutomationProperties.Name="Machine Module">
                        <Image Source="avares://AgOpenGPS/btnImages/Config/ConS_ModulesMachine.png" Stretch="Uniform" Height="32" />
                    </Button>
                    <Button x:Name="btnMachineRelay" Classes="navSubButton" MinHeight="50" AutomationProperties.Name="Machine Relay">
                        <Image Source="avares://AgOpenGPS/btnImages/Config/ConS_Pins.png" Stretch="Uniform" Height="32" />
                    </Button>
                    </StackPanel>
                <Button x:Name="btnUTurn" Classes="navButton" MinHeight="64" AutomationProperties.Name="U Turn">
                    <Image Source="avares://AgOpenGPS/btnImages/Config/Con_UTurnMenu.png" Stretch="Uniform" Height="40" />
                </Button>
                <Button x:Name="btnTram" Classes="navButton" MinHeight="64" AutomationProperties.Name="Tram">
                    <Image Source="avares://AgOpenGPS/btnImages/Config/Con_TramMenu.png" Stretch="Uniform" Height="40" />
                </Button>
                <Button x:Name="btnDisplay" Classes="navButton" MinHeight="64" AutomationProperties.Name="Display">
                    <Image Source="avares://AgOpenGPS/btnImages/Config/Con_Display.png" Stretch="Uniform" Height="40" />
                </Button>
                <Button x:Name="btnFeatureHides" Classes="navButton" MinHeight="64" AutomationProperties.Name="Feature Hides">
                    <Image Source="avares://AgOpenGPS/btnImages/Config/Con_FeatureMenu.png" Stretch="Uniform" Height="40" />
                </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================== CENTRAL CONTENT (tab1, hidden headers) =====================
             All 20 TabItems declared with exact x:Name; code-behind selects by name (nav routing). -->
        <TabControl x:Name="tab1" Canvas.Left="124" Canvas.Top="4" Width="867" Height="632" SelectedIndex="0">
            <TabItem x:Name="tabSummary">
                <Canvas Width="859" Height="584">
                    <cfg:ConfigSummaryControl x:Name="configSummaryControl" Canvas.Left="0" Canvas.Top="0" />
                </Canvas>
            </TabItem>
            <TabItem x:Name="tabVConfig">
                <Canvas Width="859" Height="584">
                    <cfg:ConfigVehicleControl x:Name="configVehicleControl" Canvas.Left="0" Canvas.Top="0" />
                </Canvas>
            </TabItem>
            <TabItem x:Name="tabVDimensions">
                <Canvas Width="859" Height="584">
                    <Image x:Name="pictureBox1" Canvas.Left="4" Canvas.Top="22" Width="814" Height="545" Source="avares://AgOpenGPS/btnImages/RadiusWheelBase.png" Stretch="Uniform" />
                    <Button x:Name="nudWheelbase" Canvas.Left="179" Canvas.Top="397" Width="152" Height="52" Classes="numeric" FontSize="37" AutomationProperties.Name="Wheelbase" />
                    <Button x:Name="nudVehicleTrack" Canvas.Left="700" Canvas.Top="165" Width="133" Height="52" Classes="numeric" FontSize="37" AutomationProperties.Name="Vehicle Track" />
                    <Button x:Name="nudTractorHitchLength" Canvas.Left="37" Canvas.Top="272" Width="152" Height="52" Classes="numeric" FontSize="37" AutomationProperties.Name="Tractor Hitch Length" />
                    <TextBlock x:Name="labelWheelBase2" Canvas.Left="179" Canvas.Top="453" Width="152" Height="16" TextAlignment="Center" TextWrapping="Wrap" Text="Wheelbase" />
                    <TextBlock x:Name="labelTrack" Canvas.Left="700" Canvas.Top="221" Width="133" Height="16" TextAlignment="Center" TextWrapping="Wrap" Text="Track" />
                    <TextBlock x:Name="labelHitchLength" Canvas.Left="37" Canvas.Top="327" Width="152" Height="16" TextAlignment="Center" TextWrapping="Wrap" Text="Hitch Length" />
                    <TextBlock x:Name="label94" Canvas.Left="197" Canvas.Top="289" Width="32" Height="19" FontSize="16" FontWeight="Bold" TextAlignment="Right" TextWrapping="Wrap" Text="cm" />
                    <TextBlock x:Name="label95" Canvas.Left="236" Canvas.Top="375" Width="32" Height="19" FontSize="16" FontWeight="Bold" TextAlignment="Right" TextWrapping="Wrap" Text="cm" />
                    <TextBlock x:Name="label97" Canvas.Left="750" Canvas.Top="143" Width="32" Height="19" FontSize="16" FontWeight="Bold" TextAlignment="Right" TextWrapping="Wrap" Text="cm" />
                    <Image x:Name="HitchLengthBlindBox" Canvas.Left="21" Canvas.Top="36" Width="349" Height="230" Stretch="Uniform" />
                </Canvas>
            </TabItem>
            <TabItem x:Name="tabVAntenna">
                <Canvas Width="859" Height="584">
                    <Image x:Name="pboxAntenna" Canvas.Left="22" Canvas.Top="106" Width="514" Height="446" Source="avares://AgOpenGPS/btnImages/AntennaTractor.png" Stretch="Uniform" />
                    <Button x:Name="nudAntennaPivot" Canvas.Left="126" Canvas.Top="43" Width="144" Height="52" Classes="numeric" FontSize="37" AutomationProperties.Name="Antenna Pivot" />
                    <Button x:Name="nudAntennaHeight" Canvas.Left="392" Canvas.Top="208" Width="144" Height="52" Classes="numeric" FontSize="37" AutomationProperties.Name="Antenna Height" />
                    <Button x:Name="nudAntennaOffset" Canvas.Left="474" Canvas.Top="352" Width="144" Height="52" Classes="numeric" FontSize="37" AutomationProperties.Name="Antenna Offset" />
                    <TextBlock x:Name="label98" Canvas.Left="276" Canvas.Top="62" Width="32" Height="19" FontSize="16" FontWeight="Bold" TextAlignment="Right" TextWrapping="Wrap" Text="cm" />
                    <TextBlock x:Name="label99" Canvas.Left="540" Canvas.Top="225" Width="32" Height="19" FontSize="16" FontWeight="Bold" TextAlignment="Right" TextWrapping="Wrap" Text="cm" />
                    <TextBlock x:Name="label100" Canvas.Left="620" Canvas.Top="371" Width="32" Height="19" FontSize="16" FontWeight="Bold" TextAlignment="Right" TextWrapping="Wrap" Text="cm" />
                    <TextBlock x:Name="labelDualPositionOnRight" Canvas.Left="370" Canvas.Top="565" Width="377" Height="16" FontSize="13" TextAlignment="Right" TextWrapping="Wrap" Text="** Dual Position Antenna on Right" />
                    <TextBlock x:Name="labelRight" Canvas.Left="648" Canvas.Top="534" Width="73" Height="16" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Text="Right" />
                    <TextBlock x:Name="labelLeft" Canvas.Left="370" Canvas.Top="534" Width="73" Height="16" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Text="Left" />
                    <Border x:Name="labelAntOffset" Canvas.Left="342" Canvas.Top="417" Width="405" Height="114" Classes="groupbox">
                        <Canvas>
                            <TextBlock Classes="groupHeader" Canvas.Left="8" Canvas.Top="1" Text="Antenna Offset" />
                            <RadioButton x:Name="rbtnAntennaLeft" Canvas.Left="28" Canvas.Top="25" Width="73" Height="81" GroupName="labelAntOffset" Classes="imageToggle" AutomationProperties.Name="Antenna Left">
                                <Image Source="avares://AgOpenGPS/btnImages/AntennaLeftOffset.png" Stretch="Uniform" />
                            </RadioButton>
                            <RadioButton x:Name="rbtnAntennaRight" Canvas.Left="306" Canvas.Top="25" Width="73" Height="81" GroupName="labelAntOffset" Classes="imageToggle" AutomationProperties.Name="Antenna Right">
                                <Image Source="avares://AgOpenGPS/btnImages/AntennaRightOffset.png" Stretch="Uniform" />
                            </RadioButton>
                            <RadioButton x:Name="rbtnAntennaCenter" Canvas.Left="168" Canvas.Top="25" Width="73" Height="81" GroupName="labelAntOffset" Classes="imageToggle" AutomationProperties.Name="Antenna Center">
                                <Image Source="avares://AgOpenGPS/btnImages/AntennaNoOffset.png" Stretch="Uniform" />
                            </RadioButton>
                        </Canvas>
                    </Border>
                    <TextBlock x:Name="labelCenter" Canvas.Left="510" Canvas.Top="534" Width="73" Height="16" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Text="Center" />
                    <TextBlock x:Name="labelAntHeight" Canvas.Left="394" Canvas.Top="263" Width="142" Height="16" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Text="Antenna Height" />
                    <TextBlock x:Name="labelPivotDistance" Canvas.Left="126" Canvas.Top="24" Width="144" Height="16" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Text="Pivot Distance" />
                </Canvas>
            </TabItem>
            <TabItem x:Name="tabVGuidance">
                <Canvas Width="859" Height="584">
                </Canvas>
            </TabItem>
            <TabItem x:Name="tabTConfig">
                <Canvas Width="859" Height="584">
                    <Border x:Name="labelBoxAttachmentStyle" Canvas.Left="45" Canvas.Top="57" Width="727" Height="484" Classes="groupbox">
                        <Canvas>
                            <TextBlock Classes="groupHeader" Canvas.Left="8" Canvas.Top="1" Text="Attachment Style" />
                            <RadioButton x:Name="rbtnTrailing" Canvas.Left="394" Canvas.Top="290" Width="309" Height="152" GroupName="labelBoxAttachmentStyle" Classes="imageToggle" AutomationProperties.Name="Trailing">
                                <Image Source="avares://AgOpenGPS/btnImages/ToolChkTrailing.png" Stretch="Uniform" />
                            </RadioButton>
                            <RadioButton x:Name="rbtnFront" Canvas.Left="16" Canvas.Top="290" Width="309" Height="152" GroupName="labelBoxAttachmentStyle" Classes="imageToggle" AutomationProperties.Name="Front">
                                <Image Source="avares://AgOpenGPS/btnImages/ToolChkFront.png" Stretch="Uniform" />
                            </RadioButton>
                            <RadioButton x:Name="rbtnFixedRear" Canvas.Left="16" Canvas.Top="48" Width="309" Height="152" GroupName="labelBoxAttachmentStyle" Classes="imageToggle" AutomationProperties.Name="Fixed Rear">
                                <Image Source="avares://AgOpenGPS/btnImages/ToolChkRear.png" Stretch="Uniform" />
                            </RadioButton>
                            <RadioButton x:Name="rbtnTBT" Canvas.Left="394" Canvas.Top="48" Width="309" Height="152" GroupName="labelBoxAttachmentStyle" Classes="imageToggle" AutomationProperties.Name="T B T">
                                <Image Source="avares://AgOpenGPS/btnImages/ToolChkTBT.png" Stretch="Uniform" />
                            </RadioButton>
                            <Image x:Name="pboxConfigHarvester" Canvas.Left="206" Canvas.Top="123" Width="305" Height="206" Source="avares://AgOpenGPS/btnImages/vehiclePageHarvester.png" Stretch="Uniform" />
                        </Canvas>
                    </Border>
                </Canvas>
            </TabItem>
            <TabItem x:Name="tabTHitch">
                <Canvas Width="859" Height="584">
                    <Image x:Name="picboxToolHitch" Canvas.Left="13" Canvas.Top="12" Width="838" Height="407" Source="avares://AgOpenGPS/btnImages/ToolHitchPageFront.png" Stretch="Uniform" />
                    <Button x:Name="nudTankHitch" Canvas.Left="643" Canvas.Top="407" Width="124" Height="52" Classes="numeric" FontSize="37" AutomationProperties.Name="Tank Hitch" />
                    <Button x:Name="nudDrawbarLength" Canvas.Left="401" Canvas.Top="407" Width="124" Height="52" Classes="numeric" FontSize="37" AutomationProperties.Name="Drawbar Length" />
                    <Button x:Name="nudTrailingHitchLength" Canvas.Left="456" Canvas.Top="407" Width="124" Height="52" Classes="numeric" FontSize="37" AutomationProperties.Name="Trailing Hitch Length" />
                    <TextBlock x:Name="labelTractorUnits" Canvas.Left="368" Canvas.Top="476" Width="57" Height="19" FontSize="16" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Text="Units:" />
                    <TextBlock x:Name="label112" Canvas.Left="381" Canvas.Top="495" Width="32" Height="19" FontSize="16" FontWeight="Bold" TextAlignment="Right" TextWrapping="Wrap" Text="cm" />
                </Canvas>
            </TabItem>
            <TabItem x:Name="tabToolOffset">
                <Canvas Width="859" Height="584">
                    <Button x:Name="nudOffset" Canvas.Left="233" Canvas.Top="109" Width="114" Height="52" Classes="numeric" FontSize="37" AutomationProperties.Name="Offset" />
                    <Button x:Name="nudOverlap" Canvas.Left="656" Canvas.Top="109" Width="114" Height="52" Classes="numeric" FontSize="37" AutomationProperties.Name="Overlap" />
                    <Border x:Name="labelToolOffset" Canvas.Left="28" Canvas.Top="201" Width="389" Height="290" Classes="groupbox">
                        <Canvas>
                            <TextBlock Classes="groupHeader" Canvas.Left="8" Canvas.Top="1" Text="Tool Offset" />
                            <TextBlock x:Name="labelToolLeft" Canvas.Left="17" Canvas.Top="256" Width="166" Height="16" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Text="Tool Left" />
                            <RadioButton x:Name="rbtnToolRightPositive" Canvas.Left="205" Canvas.Top="35" Width="166" Height="218" GroupName="labelToolOffset" Classes="imageToggle" AutomationProperties.Name="Tool Right Positive">
                                <Image Source="avares://AgOpenGPS/btnImages/Config/ToolOffsetPositiveRight.png" Stretch="Uniform" />
                            </RadioButton>
                            <RadioButton x:Name="rbtnLeftNegative" Canvas.Left="17" Canvas.Top="35" Width="166" Height="218" GroupName="labelToolOffset" Classes="imageToggle" AutomationProperties.Name="Left Negative">
                                <Image Source="avares://AgOpenGPS/btnImages/Config/ToolOffsetNegativeLeft.png" Stretch="Uniform" />
                            </RadioButton>
                            <TextBlock x:Name="labelToolRight" Canvas.Left="205" Canvas.Top="256" Width="166" Height="16" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Text="Tool Right" />
                        </Canvas>
                    </Border>
                    <Border x:Name="labelOverlapGap" Canvas.Left="442" Canvas.Top="201" Width="396" Height="290" Classes="groupbox">
                        <Canvas>
