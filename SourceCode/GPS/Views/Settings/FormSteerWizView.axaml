                    </TabItem>
                    <TabItem x:Name="tabRollZero">
                        <Grid Background="White">
                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="lblRoll2" Canvas.Left="274" Canvas.Top="263" Width="100" FontSize="27" FontWeight="Bold" TextAlignment="Left" Text="-2.5" />
                                <TextBlock x:Name="label110" Canvas.Left="181" Canvas.Top="263" Width="100" FontSize="27" TextAlignment="Right" Text="Roll:" />
                                <TextBlock x:Name="label47" Canvas.Left="334" Canvas.Top="117" Width="57" FontSize="11" FontWeight="Bold" Text="Zero Roll" />
                                <TextBlock x:Name="label57" Canvas.Left="111" Canvas.Top="117" Width="91" FontSize="11" FontWeight="Bold" Text="Remove Offset" />
                                <TextBlock x:Name="lblRollZeroOffset" Canvas.Left="469" Canvas.Top="164" Width="87" FontSize="27" Text="Offset" />
                                <Button x:Name="btnZeroRoll" AutomationProperties.Name="Zero Roll" Classes="flatImage" Canvas.Left="326" Canvas.Top="136" Width="130" Height="95" FontSize="16" />
                                <Button x:Name="btnRemoveZeroOffset" AutomationProperties.Name="Remove Zero Offset" Classes="flatImage" Canvas.Left="103" Canvas.Top="136" Width="130" Height="95" FontSize="64" FontWeight="Bold" />
                                <TextBlock x:Name="label48" Canvas.Left="69" Canvas.Top="44" Width="484" Height="56" FontSize="21" TextAlignment="Center" TextWrapping="Wrap" Text="Park on level surface and touch &quot;Zero Roll&quot;" />
                                <Button x:Name="button3" AutomationProperties.Name="Previous — Roll Zero" Classes="flatImage" Canvas.Left="486" Canvas.Top="270" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label56" Canvas.Left="6" Canvas.Top="6" Width="105" FontSize="21" FontWeight="Bold" TextAlignment="Right" Text="Roll Zero" />
                                <Button x:Name="button19" AutomationProperties.Name="Next — Roll Zero" Classes="flatImage" Canvas.Left="577" Canvas.Top="270" Width="72" Height="72" FontSize="19" />
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabWAS">
