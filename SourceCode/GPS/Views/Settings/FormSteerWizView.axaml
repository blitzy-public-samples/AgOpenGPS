                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="label116" Canvas.Left="50" Canvas.Top="114" Width="530" Height="152" FontSize="21" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Text="Now go drive an AB Line and fine tune settings based on your speed and soil conditions.&#10;&#10;Remember: CPD, Min PWM, and Look Ahead are critical settings. " />
                                <Button x:Name="btnRestartWizard" AutomationProperties.Name="Restart Wizard" Canvas.Left="222" Canvas.Top="53" Width="178" Height="33" FontSize="19" Background="LightBlue" Content="Restart Wizard" />
                                <TextBlock x:Name="label69" Canvas.Left="258" Canvas.Top="20" Width="111" FontSize="21" FontWeight="Bold" TextAlignment="Right" Text="Finished !" />
                                <Button x:Name="btnPrev_End" AutomationProperties.Name="Prev End" Classes="flatImage" Canvas.Left="451" Canvas.Top="271" Width="72" Height="72" FontSize="19" />
                                <Button x:Name="btnExit" AutomationProperties.Name="Exit" Classes="flatImage" Canvas.Left="546" Canvas.Top="271" Width="104" Height="72" FontSize="19" />
                            </Canvas>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Canvas>
        </Border>

        <Button x:Name="btnStopWizard" AutomationProperties.Name="Stop Wizard" Canvas.Left="18" Canvas.Top="7" Width="148" Height="38" FontSize="19" Background="LightCoral" Content="Restart Wizard" />
        <Border x:Name="panel2" Canvas.Left="5" Canvas.Top="430" Width="665" Height="123" Background="White" BorderBrush="Gray" BorderThickness="1">
            <Canvas ClipToBounds="True">
                <Button x:Name="btnSteerStatus" AutomationProperties.Name="Steer Status" Canvas.Left="14" Canvas.Top="4" Width="135" Height="118" FontSize="19" Background="White" />
                <TextBlock x:Name="label35" Canvas.Left="194" Canvas.Top="74" Width="33" FontSize="13" FontWeight="Bold" TextAlignment="Right" Text="Left" />
                <TextBlock x:Name="label34" Canvas.Left="572" Canvas.Top="74" Width="41" FontSize="13" FontWeight="Bold" TextAlignment="Right" Text="Right" />
                <TextBlock x:Name="lblError" Canvas.Left="352" Canvas.Top="84" Width="101" FontSize="27" FontWeight="Bold" TextAlignment="Left" Text="-30.0" />
                <TextBlock x:Name="label12" Canvas.Left="217" Canvas.Top="2" Width="68" FontSize="24" TextAlignment="Right" Text="Set:" />
                <TextBlock x:Name="lblSteerAngle" Canvas.Left="278" Canvas.Top="4" Width="100" FontSize="27" FontWeight="Bold" TextAlignment="Left" Text="-55.5" />
                <TextBlock x:Name="label9" Canvas.Left="547" Canvas.Top="95" Width="64" FontSize="19" TextAlignment="Right" Background="White" Text="PWM:" />
                <TextBlock x:Name="lblPWMDisplay" Canvas.Left="607" Canvas.Top="96" Width="46" FontSize="19" FontWeight="Bold" TextAlignment="Left" Background="White" Text="255" />
                <TextBlock x:Name="lblSteerAngleActual" Canvas.Left="484" Canvas.Top="4" Width="100" FontSize="27" FontWeight="Bold" TextAlignment="Left" Text="-55.5" />
                <TextBlock x:Name="label13" Canvas.Left="286" Canvas.Top="84" Width="75" FontSize="24" TextAlignment="Right" Text="Error:" />
                <ProgressBar x:Name="pbarLeft" Canvas.Left="187" Canvas.Top="36" Width="212" Height="35" Minimum="0" Maximum="49" FlowDirection="RightToLeft" />
                <ProgressBar x:Name="pbarRight" Canvas.Left="401" Canvas.Top="36" Width="212" Height="35" Minimum="0" Maximum="49" />
                <TextBlock x:Name="label11" Canvas.Left="411" Canvas.Top="4" Width="81" FontSize="24" TextAlignment="Right" Text="WAS:" />
            </Canvas>
        </Border>

        <Border x:Name="panel1" Canvas.Left="915" Canvas.Top="43" Width="429" Height="100" ZIndex="50" Background="WhiteSmoke">
            <Canvas ClipToBounds="True">
                <TextBlock x:Name="label38" Canvas.Left="13" Canvas.Top="72" Width="73" FontSize="13" FontWeight="Bold" TextAlignment="Right" Text="Free Drive" />
                <Button x:Name="btnFreeDriveZero" AutomationProperties.Name="Free Drive Zero" Classes="flatImage" Canvas.Left="340" Canvas.Top="13" Width="73" Height="56" FontSize="19" FontWeight="Bold" />
                <RepeatButton x:Name="btnSteerAngleUp" AutomationProperties.Name="Steer Angle Up" Classes="flatImage" Canvas.Left="230" Canvas.Top="14" Width="73" Height="74" FontSize="19" />
                <Button x:Name="btnFreeDrive" AutomationProperties.Name="Free Drive" Canvas.Left="13" Canvas.Top="13" Width="73" Height="56" FontSize="16" FontWeight="Bold" Background="WhiteSmoke" />
                <RepeatButton x:Name="btnSteerAngleDown" AutomationProperties.Name="Steer Angle Down" Classes="flatImage" Canvas.Left="124" Canvas.Top="13" Width="73" Height="74" FontSize="19" />
                <TextBlock x:Name="label14" Canvas.Left="355" Canvas.Top="71" Width="45" FontSize="13" FontWeight="Bold" TextAlignment="Right" Text="Or +5" />
            </Canvas>
        </Border>

        <!-- tabControl1: parked OFF-SCREEN (WinForms @ (988,204)); holds the gain sliders/labels
             that the wizard surfaces during PGain/Stanley/Integral tuning. -->
        <TabControl x:Name="tabControl1" Canvas.Left="988" Canvas.Top="204" Width="356" Height="379" FontSize="16">
            <TabItem x:Name="tabSteer">
                <Grid Background="Gainsboro">
                    <Canvas Width="348" Height="323" ClipToBounds="True"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Slider x:Name="hsbarLowSteerPWM" AutomationProperties.Name="Low Steer PWM" Orientation="Horizontal"
                                Canvas.Left="65" Canvas.Top="225" Width="195" Height="30" Minimum="0" Maximum="255" Value="1" LargeChange="1" />
                        <TextBlock x:Name="label6" Canvas.Left="196" Canvas.Top="203" Width="38" FontSize="16" TextAlignment="Center" Text="Low" />
                        <TextBlock x:Name="lblLowSteerPWM" Canvas.Left="5" Canvas.Top="223" Width="61" FontSize="24" TextAlignment="Right" Text="888" />
                    </Canvas>
                </Grid>
            </TabItem>
            <TabItem x:Name="tabGain">
                <Grid Background="Gainsboro">
                    <Canvas Width="348" Height="323" ClipToBounds="True"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                    </Canvas>
                </Grid>
            </TabItem>
            <TabItem x:Name="tabStan">
                <Grid Background="Gainsboro">
                    <Canvas Width="348" Height="323" ClipToBounds="True"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock x:Name="lblIntegralPercent" Canvas.Left="3" Canvas.Top="245" Width="60" FontSize="24" TextAlignment="Right" Text="888" />
                        <Slider x:Name="hsbarIntegral" AutomationProperties.Name="Integral" Orientation="Horizontal"
                                Canvas.Left="68" Canvas.Top="247" Width="202" Height="30" Minimum="0" Maximum="100" Value="5" LargeChange="1" />
                        <TextBlock x:Name="label27" Canvas.Left="63" Canvas.Top="218" Width="204" FontSize="16" TextAlignment="Center" Text="Integral" />
                        <TextBlock x:Name="label25" Canvas.Left="117" Canvas.Top="3" Width="114" FontSize="21" FontWeight="Bold" TextAlignment="Center" Foreground="SandyBrown" Text="Stanley" />
                        <TextBlock x:Name="lblHeadingErrorGain" Canvas.Left="9" Canvas.Top="152" Width="54" FontSize="24" TextAlignment="Right" Text="888" />
                        <TextBlock x:Name="lblStanleyGain" Canvas.Left="9" Canvas.Top="64" Width="54" FontSize="24" TextAlignment="Right" Text="888" />
                        <TextBlock x:Name="label5" Canvas.Left="62" Canvas.Top="126" Width="204" FontSize="16" TextAlignment="Center" Text="Heading" />
                        <TextBlock x:Name="label3" Canvas.Left="63" Canvas.Top="37" Width="204" FontSize="16" TextAlignment="Center" Text="Distance" />
                        <Slider x:Name="hsbarStanleyGain" AutomationProperties.Name="Stanley Gain" Orientation="Horizontal"
                                Canvas.Left="68" Canvas.Top="66" Width="200" Height="30" Minimum="1" Maximum="40" Value="10" LargeChange="1" />
                        <Slider x:Name="hsbarHeadingErrorGain" AutomationProperties.Name="Heading Error Gain" Orientation="Horizontal"
                                Canvas.Left="68" Canvas.Top="156" Width="200" Height="30" Minimum="1" Maximum="15" Value="10" LargeChange="1" />
                    </Canvas>
                </Grid>
            </TabItem>
            <TabItem x:Name="tabInt">
                <Grid Background="Gainsboro">
                    <Canvas Width="348" Height="323" ClipToBounds="True"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock x:Name="lblSideHillComp" Canvas.Left="6" Canvas.Top="209" Width="60" FontSize="24" TextAlignment="Right" Text="888" />
                        <Slider x:Name="hsbarSideHillComp" AutomationProperties.Name="Side Hill Comp" Orientation="Horizontal"
                                Canvas.Left="69" Canvas.Top="208" Width="217" Height="30" Minimum="0" Maximum="100" Value="5" LargeChange="1" />
                        <TextBlock x:Name="label22" Canvas.Left="73" Canvas.Top="187" Width="210" FontSize="16" TextAlignment="Center" Text="Sidehill Deg per Deg of Roll" />
                        <TextBlock x:Name="lblPureIntegral" Canvas.Left="5" Canvas.Top="279" Width="60" FontSize="24" TextAlignment="Right" Text="888" />
                        <Slider x:Name="hsbarIntegralPurePursuit" AutomationProperties.Name="Integral Pure Pursuit" Orientation="Horizontal"
                                Canvas.Left="68" Canvas.Top="280" Width="217" Height="30" Minimum="0" Maximum="100" Value="5" LargeChange="1" />
                        <TextBlock x:Name="label26" Canvas.Left="88" Canvas.Top="4" Width="172" FontSize="21" FontWeight="Bold" TextAlignment="Center" Foreground="SteelBlue" Text="Pure Pursuit" />
                        <TextBlock x:Name="label24" Canvas.Left="74" Canvas.Top="257" Width="204" FontSize="16" TextAlignment="Center" Text="Integral" />
                        <TextBlock x:Name="label21" Canvas.Left="74" Canvas.Top="42" Width="204" FontSize="16" TextAlignment="Center" Text="Look Ahead (m)" />
                        <TextBlock x:Name="label20" Canvas.Left="579" Canvas.Top="228" Width="204" FontSize="16" TextAlignment="Center" Foreground="#FFF0F0F0" Text="Look Ahead Min" />
                        <TextBlock x:Name="label19" Canvas.Left="74" Canvas.Top="114" Width="204" FontSize="16" TextAlignment="Center" Text="Look Ahead Speed Gain" />
                        <TextBlock x:Name="label18" Canvas.Left="561" Canvas.Top="13" Width="204" FontSize="16" TextAlignment="Center" Foreground="#FFF0F0F0" Text="Look Ahead" />
                        <Slider x:Name="hsbarLookAheadMult" AutomationProperties.Name="Look Ahead Mult" Orientation="Horizontal"
                                Canvas.Left="68" Canvas.Top="136" Width="217" Height="30" Minimum="5" Maximum="30" Value="6" LargeChange="1" />
                        <TextBlock x:Name="lblLookAhead" Canvas.Left="4" Canvas.Top="61" Width="60" FontSize="24" TextAlignment="Right" Text="888" />
                        <TextBlock x:Name="lblLookAheadMult" Canvas.Left="4" Canvas.Top="141" Width="60" FontSize="24" TextAlignment="Right" Text="888" />
                    </Canvas>
                </Grid>
            </TabItem>
        </TabControl>


        <!-- [XPLAT] Parked phantom controls: required by the agent control-surface contract but not
             present in FormSteerWiz.Designer.cs (hsbarSteerAngleSensorZero is an event-handler name
             aliased to hsbarWasOffset; btnOkNext/btnPrev are generic aliases of the per-tab
             btnOkNext_*/btnPrev_* buttons). Kept off-canvas + collapsed so the code-behind surface
             resolves without affecting layout. -->
        <Slider x:Name="hsbarSteerAngleSensorZero" Orientation="Horizontal" IsVisible="False" Canvas.Left="-2000" Canvas.Top="-2000" Width="100" Minimum="-4000" Maximum="4000" SmallChange="2" LargeChange="20" />
        <Button x:Name="btnOkNext" IsVisible="False" Canvas.Left="-2000" Canvas.Top="-2000" Width="1" Height="1" />
        <Button x:Name="btnPrev" IsVisible="False" Canvas.Left="-2000" Canvas.Top="-2000" Width="1" Height="1" />

    </Canvas>
</Window>
