<!-- [XPLAT] migrated from net48/WinForms FormSteerWiz — see TRANSITION_MAP.md -->
<!--
    [XPLAT] Avalonia 1:1 parity reimplementation of the WinForms AutoSteer Configuration WIZARD
    (Forms/Settings/FormSteerWiz.cs + FormSteerWiz.Designer.cs). Per AAP §0.3.3 this is a faithful
    layout port: the markup reproduces the original control tree, x:Names, geometry and ordering;
    all behaviour (PGN encode/decode, calibration, defaults, tab navigation, status colouring,
    button imagery) lives in the code-behind FormSteerWizView.axaml.cs and is reached by x:Name —
    so this view declares NO x:DataType, NO DataContext and NO {Binding}, exactly like the WinForms
    Form which used direct member access.

    Faithful to FormSteerWiz.Designer.cs: ClientSize 805x558. A top status strip (Progress bar +
    side-bar readouts), the central tabbed wizard (tabWiz — 26 pages, headers HIDDEN, navigated
    programmatically via SelectedIndex), a bottom telemetry strip (panel2), a free-drive overlay
    (panel1) and a parked gain-slider TabControl (tabControl1). Every control keeps its exact
    WinForms Location/Size on an absolute Canvas; WinForms point fonts are converted to Avalonia
    DIPs (x96/72). HScrollBar->Slider, ProgressBar->ProgressBar, NudlessNumericUpDown->numeric
    Button, CheckBox(Appearance.Button)->imageToggle CheckBox, ComboBox(DropDownList)->ComboBox,
    Button(Flat)->flatImage Button, Label->TextBlock, PictureBox->Image, Panel->Border+Canvas.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gStr="clr-namespace:AgOpenGPS.Core.Translations;assembly=AgOpenGPS.Core"
        x:Class="AgOpenGPS.Views.Settings.FormSteerWizView"
        Title="Auto Steer Wizard"
        Width="805" Height="558"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Tahoma"
        Background="{DynamicResource AogFrameBrush}">

    <Window.Styles>
        <!-- WinForms labels render Black / ActiveCaptionText. -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="Black" />
        </Style>

        <!-- Image-toggle CheckBoxes (WinForms Appearance.Button): flat image whose Background
             turns MediumAquamarine when :checked (FlatAppearance.CheckedBackColor). -->
        <Style Selector="CheckBox.imageToggle">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.imageToggle:checked">
            <Setter Property="Background" Value="MediumAquamarine" />
        </Style>

        <!-- Flat, image-only push buttons (FlatStyle.Flat). -->
        <Style Selector="Button.flatImage">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="RepeatButton.flatImage">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <!-- Numeric-entry buttons (WinForms NudlessNumericUpDown look). -->
        <Style Selector="Button.numeric">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Section heading labels. -->
        <Style Selector="TextBlock.heading">
            <Setter Property="Foreground" Value="SteelBlue" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- tabWiz: hide the tab strip entirely (WinForms ItemSize=(0,1), headers invisible;
             navigation is driven programmatically via SelectedIndex). -->
        <Style Selector="TabControl#tabWiz /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Window.Styles>

    <!-- WinForms FormSteerWiz ClientSize 805 x 558; absolute positioning preserves every Location/Size. -->
    <Canvas Width="805" Height="558">

        <Button x:Name="btnCloseAll" AutomationProperties.Name="Close All" Classes="flatImage" Canvas.Left="688" Canvas.Top="479" Width="104" Height="72" FontSize="19" />
        <TextBlock x:Name="label67" Canvas.Left="675" Canvas.Top="72" Width="104" FontSize="19" TextAlignment="Right" Text="WAS Offset" />
        <TextBlock x:Name="lblBarWasOffset" Canvas.Left="675" Canvas.Top="93" Width="51" FontSize="21" FontWeight="Bold" TextAlignment="Left" Text="888" />
        <TextBlock x:Name="label65" Canvas.Left="675" Canvas.Top="176" Width="104" FontSize="19" TextAlignment="Right" Text="Ackermann" />
        <TextBlock x:Name="lblBarAck" Canvas.Left="675" Canvas.Top="198" Width="51" FontSize="21" FontWeight="Bold" TextAlignment="Left" Text="888" />
        <TextBlock x:Name="label66" Canvas.Left="675" Canvas.Top="124" Width="123" FontSize="19" TextAlignment="Right" Text="Counts P Deg" />
        <TextBlock x:Name="lblBarCPD" Canvas.Left="675" Canvas.Top="146" Width="51" FontSize="21" FontWeight="Bold" TextAlignment="Left" Text="888" />
        <TextBlock x:Name="label71" Canvas.Left="235" Canvas.Top="12" Width="100" FontSize="19" FontWeight="Bold" TextAlignment="Right" Text="Progress:" />
        <ProgressBar x:Name="pbarProgress" Canvas.Left="336" Canvas.Top="18" Width="323" Height="15" Minimum="0" Maximum="100" />
        <Border x:Name="panel3" Canvas.Left="5" Canvas.Top="51" Width="665" Height="373" BorderBrush="Gray" BorderThickness="1">
            <Canvas>
                <TabControl x:Name="tabWiz" Canvas.Left="0" Canvas.Top="0" Width="663" Height="371" FontSize="16">
                    <TabItem x:Name="tabStart">
                        <Grid Background="White">
                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Button x:Name="btnStartWizard" AutomationProperties.Name="Start Wizard" Canvas.Left="226" Canvas.Top="106" Width="199" Height="80" FontSize="19" Background="PaleGreen" Content="Start Wizard" />
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabLoadDef">
                        <Grid Background="White">
                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="label81" Canvas.Left="115" Canvas.Top="188" Width="436" FontSize="21" TextAlignment="Center" Text="Highly Recommended" />
                                <TextBlock x:Name="label80" Canvas.Left="6" Canvas.Top="5" Width="157" FontSize="21" FontWeight="Bold" TextAlignment="Center" Text="Load Defaults" />
                                <Button x:Name="btnOkNext_LoadDefault" AutomationProperties.Name="Ok Next Load Default" Classes="flatImage" Canvas.Left="576" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                                <Button x:Name="btnLoadDefaults" AutomationProperties.Name="Load Defaults" Canvas.Left="234" Canvas.Top="225" Width="199" Height="80" FontSize="19" Background="LightSteelBlue" Content="Load Defaults" />
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabWheelBase">
                        <Grid Background="White">
                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="label117" Canvas.Left="3" Canvas.Top="8" Width="455" FontSize="21" TextAlignment="Center" Background="White" />
                                <TextBlock x:Name="label89" Canvas.Left="385" Canvas.Top="5" Width="224" FontSize="21" TextAlignment="Center" Background="White" />
                                <Button x:Name="button1" AutomationProperties.Name="Previous — Wheelbase" Classes="flatImage" Canvas.Left="486" Canvas.Top="268" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label90" Canvas.Left="6" Canvas.Top="6" Width="126" FontSize="21" FontWeight="Bold" TextAlignment="Right" Text="Wheelbase" />
                                <Button x:Name="nudWheelbase" Classes="numeric" Canvas.Left="90" Canvas.Top="231" Width="143" Height="65" FontSize="48" FontWeight="Bold" Content="333" />
                                <TextBlock x:Name="label91" Canvas.Left="67" Canvas.Top="153" Width="180" FontSize="21" FontWeight="Bold" TextAlignment="Center" Background="Linen" Text="Set Wheelbase" />
                                <Button x:Name="button2" AutomationProperties.Name="Next — Wheelbase" Classes="flatImage" Canvas.Left="577" Canvas.Top="268" Width="72" Height="72" FontSize="19" />
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabWheelTrack">
                        <Grid Background="White">
                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="label118" Canvas.Left="2" Canvas.Top="6" Width="294" FontSize="21" TextAlignment="Center" Background="White" />
                                <Button x:Name="nudVehicleTrack" Classes="numeric" Canvas.Left="423" Canvas.Top="185" Width="157" Height="65" FontSize="48" FontWeight="Bold" Content="333" />
                                <TextBlock x:Name="label95" Canvas.Left="380" Canvas.Top="144" Width="255" FontSize="24" FontWeight="Bold" TextAlignment="Center" Background="Linen" Text="Set Track Width" />
                                <TextBlock x:Name="label96" Canvas.Left="300" Canvas.Top="20" Width="57" FontSize="21" TextAlignment="Center" Background="White" />
                                <Button x:Name="button7" AutomationProperties.Name="Previous — Track Width" Classes="flatImage" Canvas.Left="486" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label94" Canvas.Left="6" Canvas.Top="6" Width="142" FontSize="21" FontWeight="Bold" TextAlignment="Right" Text="Wheel Track" />
                                <Button x:Name="button8" AutomationProperties.Name="Next — Track Width" Classes="flatImage" Canvas.Left="577" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabAntennaDistance">
                        <Grid Background="White">
                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="label100" Canvas.Left="315" Canvas.Top="0" Width="151" FontSize="21" TextAlignment="Center" Background="White" />
                                <Button x:Name="button9" AutomationProperties.Name="Previous — Antenna Distance" Classes="flatImage" Canvas.Left="486" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label98" Canvas.Left="6" Canvas.Top="6" Width="99" Height="50" FontSize="21" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Text="Antenna&#10;Position" />
                                <Button x:Name="nudAntennaPivot" Classes="numeric" Canvas.Left="230" Canvas.Top="226" Width="165" Height="65" FontSize="48" FontWeight="Bold" Content="333" />
                                <Button x:Name="button10" AutomationProperties.Name="Next — Antenna Distance" Classes="flatImage" Canvas.Left="577" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label99" Canvas.Left="133" Canvas.Top="155" Width="352" Height="185" FontSize="24" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Background="Linen" Text="Set Distance Antenna Is From Pivot Axle" />
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabAntennaHeight">
                        <Grid Background="White">
                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="label114" Canvas.Left="163" Canvas.Top="0" Width="162" FontSize="21" TextAlignment="Center" Background="White" />
                                <TextBlock x:Name="label97" Canvas.Left="109" Canvas.Top="185" Width="371" FontSize="21" TextAlignment="Center" Background="White" />
                                <Button x:Name="button13" AutomationProperties.Name="Previous — Antenna Height" Classes="flatImage" Canvas.Left="486" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label92" Canvas.Left="6" Canvas.Top="6" Width="99" Height="50" FontSize="21" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Text="Antenna&#10;Height" />
                                <Button x:Name="nudAntennaHeight" Classes="numeric" Canvas.Left="465" Canvas.Top="87" Width="145" Height="65" FontSize="48" FontWeight="Bold" Content="333" />
                                <TextBlock x:Name="label93" Canvas.Left="436" Canvas.Top="12" Width="198" FontSize="24" FontWeight="Bold" TextAlignment="Center" Background="Linen" Text="Set Antenna Height" />
                                <Button x:Name="button14" AutomationProperties.Name="Next — Antenna Height" Classes="flatImage" Canvas.Left="577" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabAntennaOffset">
                        <Grid Background="White">
                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Button x:Name="button11" AutomationProperties.Name="Previous — Antenna Offset" Classes="flatImage" Canvas.Left="485" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label102" Canvas.Left="0" Canvas.Top="6" Width="169" FontSize="21" FontWeight="Bold" TextAlignment="Right" Text="Antenna Offset" />
                                <Button x:Name="nudAntennaOffset" Classes="numeric" Canvas.Left="250" Canvas.Top="65" Width="165" Height="65" FontSize="48" FontWeight="Bold" Content="333" />
                                <TextBlock x:Name="label104" Canvas.Left="471" Canvas.Top="247" Width="86" FontSize="21" FontWeight="Bold" TextAlignment="Center" Text="0 = Off" />
                                <Button x:Name="button12" AutomationProperties.Name="Next — Antenna Offset" Classes="flatImage" Canvas.Left="576" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label103" Canvas.Left="171" Canvas.Top="1" Width="313" FontSize="24" FontWeight="Bold" TextAlignment="Center" Background="Linen" Text="Set Antenna Offset" />
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabButtonSwitch">
                        <Grid Background="White">
                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Button x:Name="button15" AutomationProperties.Name="Previous — Steer Switch" Classes="flatImage" Canvas.Left="485" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label53" Canvas.Left="5" Canvas.Top="4" Width="144" FontSize="21" FontWeight="Bold" TextAlignment="Center" Text="Steer Switch" />
                                <ComboBox x:Name="cboxSteerEnable" AutomationProperties.Name="Steer Enable" Canvas.Left="195" Canvas.Top="111" Width="175" Height="37" FontSize="24" FontWeight="Bold">
                                    <ComboBoxItem>None</ComboBoxItem>
                                    <ComboBoxItem>Switch</ComboBoxItem>
                                    <ComboBoxItem>Button</ComboBoxItem>
                                </ComboBox>
                                <TextBlock x:Name="label28" Canvas.Left="182" Canvas.Top="167" Width="218" Height="95" FontSize="16" TextWrapping="Wrap" Text="Button - Push Release, On.   &#10;               Push Release, Off&#10;&#10;Switch - While Pushed is On. &#10;               Released is Off." />
                                <TextBlock x:Name="label62" Canvas.Left="84" Canvas.Top="76" Width="396" FontSize="21" TextAlignment="Center" Text="Steer Enable Mode" />
                                <Button x:Name="btnOkNext_ButtonSwitch" AutomationProperties.Name="Ok Next Button Switch" Classes="flatImage" Canvas.Left="576" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabA2DConv">
                        <Grid Background="White">
                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Button x:Name="btnPrev_A2D" AutomationProperties.Name="Prev A2 D" Classes="flatImage" Canvas.Left="485" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label52" Canvas.Left="5" Canvas.Top="4" Width="164" FontSize="21" FontWeight="Bold" TextAlignment="Center" Text="A/D Convertor" />
                                <ComboBox x:Name="cboxConv" AutomationProperties.Name="Conv" Canvas.Left="238" Canvas.Top="176" Width="175" Height="37" FontSize="24" FontWeight="Bold">
                                    <ComboBoxItem>Single</ComboBoxItem>
                                    <ComboBoxItem>Differential</ComboBoxItem>
                                </ComboBox>
                                <TextBlock x:Name="label64" Canvas.Left="114" Canvas.Top="138" Width="436" FontSize="21" TextAlignment="Center" Text="A/D Convertor Connection?" />
                                <Button x:Name="btnOkNext_A2D" AutomationProperties.Name="Ok Next A2 D" Classes="flatImage" Canvas.Left="576" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabMotorDriver">
                        <Grid Background="White">
                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Button x:Name="btnPrev_MotorDriver" AutomationProperties.Name="Prev Motor Driver" Classes="flatImage" Canvas.Left="485" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label43" Canvas.Left="4" Canvas.Top="4" Width="213" FontSize="21" FontWeight="Bold" TextAlignment="Center" Text="Motor Driver Board" />
                                <ComboBox x:Name="cboxMotorDrive" AutomationProperties.Name="Motor Drive" Canvas.Left="238" Canvas.Top="176" Width="175" Height="37" FontSize="24" FontWeight="Bold">
                                    <ComboBoxItem>Cytron</ComboBoxItem>
                                    <ComboBoxItem>IBT2</ComboBoxItem>
                                </ComboBox>
                                <TextBlock x:Name="label63" Canvas.Left="67" Canvas.Top="139" Width="529" FontSize="21" TextAlignment="Center" Text="What Style of Motor Driver?" />
                                <Button x:Name="btnOkNext_MotorDriver" AutomationProperties.Name="Ok Next Motor Driver" Classes="flatImage" Canvas.Left="576" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabInvertRelays">
                        <Grid Background="White">
                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="label59" Canvas.Left="282" Canvas.Top="236" Width="95" FontSize="13" FontWeight="Bold" TextAlignment="Right" Text="Invert Relays" />
                                <Button x:Name="btnPrev_InvertRelays" AutomationProperties.Name="Prev Invert Relays" Classes="flatImage" Canvas.Left="485" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label51" Canvas.Left="5" Canvas.Top="4" Width="223" FontSize="21" FontWeight="Bold" TextAlignment="Center" Text="Driver Control Relay" />
                                <TextBlock x:Name="label29" Canvas.Left="60" Canvas.Top="109" Width="541" FontSize="21" TextAlignment="Center" Text="Invert Hydraulic Enable Relay?" />
                                <Button x:Name="btnOkNext_InvertRelays" AutomationProperties.Name="Ok Next Invert Relays" Classes="flatImage" Canvas.Left="576" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                                <CheckBox x:Name="chkSteerInvertRelays" AutomationProperties.Name="Steer Invert Relays" Classes="imageToggle" Canvas.Left="274" Canvas.Top="155" Width="109" Height="78" />
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabDanfoss">
                        <Grid Background="White">
                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Button x:Name="btnPrev_Danfoss" AutomationProperties.Name="Prev Danfoss" Classes="flatImage" Canvas.Left="485" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label50" Canvas.Left="5" Canvas.Top="4" Width="160" FontSize="21" FontWeight="Bold" TextAlignment="Center" Text="Danfoss Valve" />
                                <TextBlock x:Name="label55" Canvas.Left="77" Canvas.Top="109" Width="501" Height="31" FontSize="21" TextAlignment="Center" TextWrapping="Wrap" Text="Do you have use a Danfoss Valve?" />
                                <Button x:Name="btnOkNext_Danfoss" AutomationProperties.Name="Ok Next Danfoss" Classes="flatImage" Canvas.Left="576" Canvas.Top="269" Width="72" Height="72" FontSize="19" />
                                <CheckBox x:Name="cboxDanfoss" AutomationProperties.Name="Danfoss" Classes="imageToggle" Canvas.Left="274" Canvas.Top="155" Width="114" Height="78" />
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabRollInv">
                        <Grid Background="White">
                            <Canvas Width="655" Height="348" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="label115" Canvas.Left="139" Canvas.Top="105" Width="268" FontSize="21" TextAlignment="Right" Text="If not Select Invert Roll" />
                                <TextBlock x:Name="lblRoll" Canvas.Left="274" Canvas.Top="274" Width="100" FontSize="27" FontWeight="Bold" TextAlignment="Left" Text="-55.5" />
                                <Image x:Name="pictureBox9" Canvas.Left="486" Canvas.Top="38" Width="154" Height="217" Stretch="Uniform" />
                                <CheckBox x:Name="cboxDataInvertRoll" AutomationProperties.Name="Data Invert Roll" Classes="imageToggle" Canvas.Left="218" Canvas.Top="169" Width="130" Height="95" />
                                <TextBlock x:Name="label36" Canvas.Left="64" Canvas.Top="50" Width="401" Height="56" FontSize="21" TextAlignment="Right" TextWrapping="Wrap" Text="Put vehicle leaning strongly to the right. Roll to the right must be POSITIVE." />
                                <Button x:Name="button4" AutomationProperties.Name="Previous — Roll Function" Classes="flatImage" Canvas.Left="486" Canvas.Top="270" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label46" Canvas.Left="6" Canvas.Top="6" Width="148" FontSize="21" FontWeight="Bold" TextAlignment="Right" Text="Roll Function" />
                                <Button x:Name="button18" AutomationProperties.Name="Next — Roll Function" Classes="flatImage" Canvas.Left="577" Canvas.Top="270" Width="72" Height="72" FontSize="19" />
                                <TextBlock x:Name="label107" Canvas.Left="181" Canvas.Top="274" Width="100" FontSize="27" TextAlignment="Right" Text="Roll:" />
