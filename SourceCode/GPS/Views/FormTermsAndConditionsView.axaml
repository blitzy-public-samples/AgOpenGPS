            <!-- buttonGitHub: WinForms Button (30,140) 120x120, image Resources.GitHub TopCenter,
                 text BottomCenter, Tahoma 11 Bold. Click opens GitHub (code-behind). -->
            <Button x:Name="buttonGitHub" Classes="linkButton" Canvas.Left="20" Canvas.Top="130" Width="120" Height="120">
                <Grid RowDefinitions="Auto,*">
                    <Image Grid.Row="0" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Source="avares://AgOpenGPS/btnImages/GitHub.png" />
                    <TextBlock Grid.Row="1" Text="Check for Updates" FontSize="14.667" FontWeight="Bold" Foreground="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" TextAlignment="Center" TextWrapping="Wrap" Margin="2,0,2,6" />
                </Grid>
            </Button>

            <!-- buttonDiscourse: WinForms Button (30,280) 120x120, image Resources.Discourse. -->
            <Button x:Name="buttonDiscourse" Classes="linkButton" Canvas.Left="20" Canvas.Top="270" Width="120" Height="120">
                <Grid RowDefinitions="Auto,*">
                    <Image Grid.Row="0" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Source="avares://AgOpenGPS/btnImages/Discourse.png" />
                    <TextBlock Grid.Row="1" Text="Discourse Forum" FontSize="14.667" FontWeight="Bold" Foreground="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" TextAlignment="Center" TextWrapping="Wrap" Margin="2,0,2,6" />
                </Grid>
            </Button>

            <!-- buttonYouTube: WinForms Button (30,412) 120x110, image Resources.YouTube. -->
            <Button x:Name="buttonYouTube" Classes="linkButton" Canvas.Left="20" Canvas.Top="402" Width="120" Height="110">
                <Grid RowDefinitions="Auto,*">
                    <Image Grid.Row="0" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Source="avares://AgOpenGPS/btnImages/YouTube.png" />
                    <TextBlock Grid.Row="1" Text="YouTube Tutorials" FontSize="14.667" FontWeight="Bold" Foreground="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" TextAlignment="Center" TextWrapping="Wrap" Margin="2,0,2,6" />
                </Grid>
            </Button>

            <!-- labelDisagree: WinForms Button (685,535) 135x90, image Resources.Cancel64 TopCenter,
                 text BottomCenter, Tahoma 12 Bold, DialogResult.Cancel. -->
            <Button x:Name="labelDisagree" Classes="linkButton" Canvas.Left="675" Canvas.Top="525" Width="135" Height="90">
                <Grid RowDefinitions="Auto,*">
                    <Image Grid.Row="0" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,2,0,0"
                           Source="avares://AgOpenGPS/btnImages/Cancel64.png" />
                    <TextBlock Grid.Row="1" Text="Disagree" FontSize="16" FontWeight="Bold" Foreground="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" TextAlignment="Center" Margin="0,0,0,4" />
                </Grid>
            </Button>

            <!-- labelAgree: WinForms Button (825,535) 135x90, image Resources.OK64 TopCenter,
                 text BottomCenter, Tahoma 12 Bold, DialogResult.OK. -->
            <Button x:Name="labelAgree" Classes="linkButton" Canvas.Left="815" Canvas.Top="525" Width="135" Height="90">
                <Grid RowDefinitions="Auto,*">
                    <Image Grid.Row="0" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,2,0,0"
                           Source="avares://AgOpenGPS/btnImages/OK64.png" />
                    <TextBlock Grid.Row="1" Text="Agree" FontSize="16" FontWeight="Bold" Foreground="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" TextAlignment="Center" Margin="0,0,0,4" />
                </Grid>
            </Button>

        </Canvas>
    </Border>
</Window>
