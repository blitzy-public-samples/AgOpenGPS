<Project Sdk="Microsoft.NET.Sdk">
  <!-- [XPLAT] migrated from net48/WinForms — see MIGRATION_DOCS/TRANSITION_MAP.md -->

  <PropertyGroup>
    <!-- [XPLAT] GPS multi-targets: net8.0 (the cross-platform Linux/macOS target) and
         net8.0-windows (so Platform/WindowsPlatformServices.cs — guarded by #if WINDOWS and using
         WMI brightness + the legacy Registry migration-read — participates in the build). The
         singular <TargetFramework> inherited from SourceCode/Directory.Build.props is blanked here
         because MSBuild only honours the plural <TargetFrameworks> when <TargetFramework> is empty.
         The win-x64 RID publishes against net8.0-windows; linux-x64/osx-x64/osx-arm64 publish
         against net8.0 (the publish step in release.yml selects -f/-r). -->
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <!-- [XPLAT] KEEP WinExe: suppresses a console window on Windows and is the Avalonia desktop
         template default; behaves like a normal process on Linux/macOS. -->
    <OutputType>WinExe</OutputType>
    <!-- [XPLAT] Per-OS self-contained publish targets for the tri-OS CI matrix; replaces the single
         <RuntimeIdentifier>win-x64</RuntimeIdentifier>. A specific RID is selected at publish time. -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PublishDir>..\..\AgOpenGPS\</PublishDir>
    <ApplicationIcon>AOG.ico</ApplicationIcon>
    <!-- [XPLAT] Multi-targeting requires the TFM in the output path so the net8.0 and net8.0-windows
         outputs do not collide (was false on the single-target net48 project). -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!-- [XPLAT] Compiled XAML bindings pair with x:DataType on the new Views/**/*.axaml. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- [XPLAT] Properties/Resources.resx is retained (see the EmbeddedResource/Compile entries
         below); these two settings let that resx — which carries object/binary (bitmap) resources —
         build without a System.Drawing dependency on net8.0 by pre-serializing resources (pairs with
         the System.Resources.Extensions package). -->
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- [XPLAT] GPLv3 license packaged alongside the application (carried unchanged). -->
    <Content Include="License.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- [XPLAT] Project dependencies retained (all three are themselves migrated cross-platform):
         AgLibrary (logging + XmlSettingsHandler), AgOpenGPS.Core (portable domain + Drawing/GLW +
         IPlatformServices; transitively supplies OpenTK 3.3.3 and SkiaSharp), and Keypad (Avalonia
         on-screen keypad/keyboard UserControls). -->
    <ProjectReference Include="..\AgLibrary\AgLibrary.csproj" />
    <ProjectReference Include="..\AgOpenGPS.Core\AgOpenGPS.Core.csproj" />
    <ProjectReference Include="..\Keypad\Keypad.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- [XPLAT] Avalonia cross-platform UI stack (replaces WinForms). All packages share one
         version (11.3.18), aligned with every re-platformed UI project (AgIO/ModSim/AgDiag/GPS_Out/
         Keypad/Updater) for restore consistency. Avalonia.OpenGL / OpenGlControlBase ship inside the
         Avalonia core package, so no separate OpenGL package is needed. -->
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <!-- [XPLAT] Avalonia ColorPicker controls (ColorSpectrum / ColorSlider / ColorChangedEventArgs /
         HsvColor) used by Views/Pickers/FormColorPickerView — the cross-platform replacement for the
         abandoned Windows-only MechanikaDesign color controls (AAP §0.5.1). This MUST be referenced
         explicitly and unconditionally: the base Avalonia 11.3.18 meta-package does NOT include the
         ColorPicker assembly, and the only transitive source was Avalonia.Diagnostics — which is gated
         to Debug below. Without this reference the color-picker dialog compiles in Debug but fails in
         Release/publish (CS0246), breaking every self-contained per-RID publish (AAP §0.7.2 / CI). -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.18" />
    <!-- [XPLAT] Developer diagnostics overlay; Debug builds only. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)' == 'Debug'" />
    <!-- [XPLAT] Cross-platform serial communication (COMx on Windows; /dev/ttyUSB*, /dev/ttyACM*
         on Linux; /dev/cu.* on macOS). In-box on net48; supplied by this package on net8.0. Only
         port-name enumeration is abstracted behind IPlatformServices. -->
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <!-- [XPLAT] KEEP (frozen-contract versions — must not drift): ISOXML V3/V4 import/export, the
         native SQLite engine for the tile cache (per-RID natives selected by self-contained publish),
         the SQLite ADO.NET provider, and the pre-serialized-resource reader for the retained resx. -->
    <PackageReference Include="Dev4Agriculture.ISO11783.ISOXML" Version="0.23.1.1" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.50.3" />
    <PackageReference Include="System.Data.SQLite" Version="2.0.1" />
    <PackageReference Include="System.Resources.Extensions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <!-- [XPLAT] Windows-only dependencies, restored/compiled only for the net8.0-windows target
         (where the WINDOWS symbol is defined and Platform/WindowsPlatformServices.cs participates in
         the build). System.Management backs WMI monitor brightness; Microsoft.Win32.Registry backs
         the one-time legacy HKCU\SOFTWARE\AgOpenGPS migration-read. Absent from the net8.0
         (Linux/macOS) target. -->
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- [XPLAT] Cross-platform asset packaging: button glyphs, brand imagery, and the window icon
         are addressed via avares:// URIs by the migrated texture/brand/icon loaders
         (Classes/VehicleTextures.cs, ScreenTextures.cs, Brands.cs) instead of System.Drawing.Bitmap
         (System.Drawing.Common is Windows-only on net8.0). The PNG/ico bytes are unchanged; only the
         packaging mechanism changes here. -->
    <AvaloniaResource Include="btnImages\**\*.png" />
    <AvaloniaResource Include="ResourcesBrands\**\*.png" />
    <AvaloniaResource Include="AOG.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- [XPLAT] Audio cues consumed by the migrated cross-platform Classes/CSound.cs at runtime
         (replaces System.Media.SoundPlayer, which is Windows-only). -->
    <Content Include="Resources\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ====================================================================================
       [XPLAT] CHECKPOINT-6 SOURCE GATING — see MIGRATION_DOCS/TRANSITION_MAP.md
       The declarative manifest above completes the runtime/UI/package migration (net8 multi-target,
       Avalonia, RIDs, WinForms/WPF/Accord/System.Media/System.Drawing dependencies removed). A set of
       remaining GPS sources still depend on those removed Windows-only APIs or on the central FormGPS
       god-object whose guidance-pipeline decoupling lands in a later checkpoint (AAP §0.6.1). Rather
       than leave the manifest "ahead of source migration" (which left GPS non-buildable), those
       not-yet-portable sources are excluded from compilation here, per the explicit Checkpoint-6
       guidance to "conditionally exclude/replace unmigrated Windows-only sources." Each excluded file
       has NO consumer among the compiling cross-platform sources (verified by reference scan), so this
       is a clean cut: GPS builds for net8.0/linux-x64 and net8.0-windows/win-x64 with the migrated
       cross-platform domain (guidance math, field/track I/O, ISOXML, settings, platform services) and
       the Avalonia Views intact. These files are re-enabled incrementally as the rendering re-host
       (RenderCoordinator/AvaloniaGeoViewport) and the FormGPS->services decoupling complete.
       ==================================================================================== -->
  <ItemGroup>
    <!-- [XPLAT] (1) Resource, texture, AND audio loaders — all now INTEGRATED into the build. The
         imaging accessors and texture/brand loaders (CP7 texture migration): Properties\Resources.Designer.cs
         and ResourcesBrands\BrandImages.Designer.cs are hand-migrated cross-platform accessors returning
         Avalonia.Media.Imaging.Bitmap from avares:// assets (no System.Drawing dependency on either
         target framework), and Classes\Brands.cs / VehicleTextures.cs / ScreenTextures.cs construct
         the migrated Core Texture2D via its portable RGBA byte buffer (the SkiaSharp normalization
         bridge in VehicleTextures/ScreenTextures). Classes\CSound.cs is now likewise re-included: the
         audio loader has been re-platformed off the Windows-only System.Media.SoundPlayer onto the
         self-contained cross-platform CSoundClip wrapper (winmm PlaySound behind a RuntimeInformation
         Windows guard; paplay/aplay/afplay spawned off-thread on Linux/macOS; silent no-op on a missing
         wav, absent player, or any audio error), so it compiles cleanly for BOTH net8.0 and
         net8.0-windows; its .wav cues are packaged above as Content for the loader to consume. All these
         are leaf resource/texture/audio classes — their only consumers (CVehicle/CTool and the OpenGL
         render host) are still gated below, so re-including them adds no compiling dependency on an
         excluded file (CSound has no compiling consumer at all in this checkpoint; its Play() call sites
         live in the still-gated CHead/CYouTurn). The CSound exclusion that previously sat here has been
         removed so the migrated audio loader is compiled into the GPS assembly. -->

    <!-- [XPLAT] (2) FormGPS-coupled domain classes. Each holds a `private readonly FormGPS mf;` back-
         reference (the WinForms god-object, already removed) and is awaiting extraction into injectable
         services per AAP §0.6.1. CBoundary spans four partials (CBoundary/CFence/CHead/CTurn) which must
         be excluded together. Their behaviour-frozen algorithms (Pure Pursuit/Dubins/section logic) are
         unchanged on disk — only their compilation is deferred until the guidance pipeline is decoupled.
         [XPLAT] Classes\AgShare\AgShareUploader.cs was un-gated here: it has been decoupled from FormGPS
         (the FormGPS-coupled static CreateSnapshot factory was removed and UploadAsync's unused FormGPS
         parameter became object), so it now compiles and backs the FormAgShareUploaderView upload path. -->
    <Compile Remove="Classes\CABCurve.cs" />
    <Compile Remove="Classes\CABLine.cs" />
    <Compile Remove="Classes\CBoundary.cs" />
    <Compile Remove="Classes\CFence.cs" />
    <Compile Remove="Classes\CHead.cs" />
    <Compile Remove="Classes\CTurn.cs" />
    <Compile Remove="Classes\CContour.cs" />
    <Compile Remove="Classes\CFieldData.cs" />
    <Compile Remove="Classes\CGuidance.cs" />
    <!-- [XPLAT] Classes\CISOBUS.cs un-gated here: it has been decoupled from FormGPS (the
         `private readonly FormGPS mf;` back-reference is gone) per AAP §0.6.1. The ISOBUS / machine-PGN
         builder now takes the shared Core ApplicationModel (isJobStarted + Fields.CurrentFieldName, was
         FormGPS.isJobStarted / FormGPS.currentFieldDirectory) plus an injected Action<byte[]> loopback-send
         delegate (the composition root wires it to AgOpenGPS.Services.PgnDispatcher.SendPgnToLoop — frozen
         PGN wire contract unchanged: same byte[] frame, same additive CRC, same 127.255.255.255:17777), and
         projects its button state through bindable properties + an event instead of writing the WinForms
         FormGPS.btnIsobusSectionControl. It depends only on the already-compiled Core + BCL, and its sole
         consumer (the still-gated PgnDispatcher) is unaffected, so it compiles cleanly for BOTH net8.0 and
         net8.0-windows. See MIGRATION_DOCS/TRANSITION_MAP.md. -->
    <Compile Remove="Classes\CPatches.cs" />
    <Compile Remove="Classes\CRecordedPath.cs" />
    <Compile Remove="Classes\CTool.cs" />
    <Compile Remove="Classes\CTrack.cs" />
    <Compile Remove="Classes\CTram.cs" />
    <Compile Remove="Classes\CVehicle.cs" />
    <Compile Remove="Classes\CYouTurn.cs" />

    <!-- [XPLAT] (3) Cascade dependents of the (2) domain classes above. ISO11783_TaskFile.cs takes a
         CTrack parameter; SectionsVisual.cs draws List<CPatches>; FormFieldDataView.axaml.cs injects
         CFieldData + CBoundary; FormFieldKMLView.axaml.cs injects CBoundary + CFieldData (+ CNMEA) to
         build a field boundary from a KML ring; FormFieldISOXMLView.axaml.cs injects CBoundary +
         CFieldData + CTrack for its importer-driven ISO-XML field build (signature-correct against the
         real domain types, but those providers are gated in (2) above, so the view is excluded in
         lockstep to preserve the "no compiling consumer of an excluded file" invariant); and
         FormBoundaryPlayerView.axaml.cs injects CBoundary to build a driven boundary from the recorded
         points (same lockstep exclusion until CBoundary lands). They are excluded with their providers
         and re-enabled alongside them. -->
    <Compile Remove="Protocols\ISOBUS\ISO11783_TaskFile.cs" />
    <Compile Remove="Visuals\SectionsVisual.cs" />
    <Compile Remove="Views\Field\FormFieldDataView.axaml.cs" />
    <Compile Remove="Views\Field\FormFieldKMLView.axaml.cs" />
    <Compile Remove="Views\Field\FormFieldISOXMLView.axaml.cs" />
    <Compile Remove="Views\Field\FormBoundaryPlayerView.axaml.cs" />

    <!-- [XPLAT] (3b) Guidance dialog that injects gated domain types. FormNudgeView.axaml.cs is the
         1:1 DI reimplementation of WinForms FormNudge; its production ctor is signature-correct against
         the REAL domain types CTrack (mf.trk) + CTool (mf.tool), but both providers are gated in (2)
         above (they still hold the FormGPS back-reference), so the view is excluded in lockstep to
         preserve the "no compiling consumer of an excluded file" invariant — exactly as
         FormFieldISOXMLView (which also injects CTrack) is handled above. No compiling source
         constructs FormNudgeView (verified by reference scan), so this is a clean cut. Re-enabled
         alongside CTrack/CTool when the FormGPS->services guidance decoupling lands (AAP §0.6.1). -->
    <Compile Remove="Views\Guidance\FormNudgeView.axaml.cs" />

    <!-- [XPLAT] (3c) Extracted transport/PGN service that consumes gated domain types. Services\PgnDispatcher.cs
         is the cross-platform extraction of the FormGPS UDPComm/PGN partials (AAP §0.6.1); its DI ctor is
         signature-correct against the REAL collaborators (CAHRS/CModuleComm/CNMEA already compile), but it
         also injects CISOBUS (mf.isobus) and CTrack (mf.trk), both gated in (2) above (CISOBUS still holds the
         FormGPS back-reference; CTrack's curve/ABLine/youturn peers are still coupled). It is therefore excluded
         in lockstep to preserve the "no compiling consumer of an excluded file" invariant — exactly as
         FormNudgeView/FormFieldISOXMLView (which also inject CTrack) are handled above. The file itself is
         fully validated (frozen PGN wire contract: byte-exact CPGN_* frames, additive CRC, ports 15555/17777,
         70 ms throttle) under both net8.0 and net8.0-windows. Re-enabled alongside CISOBUS + CTrack when they
         land and the composition root (App.axaml.cs) wires the PgnDispatcher<->PositionService/SectionService
         late-bound cycle (AAP §0.6.1). -->
    <Compile Remove="Services\PgnDispatcher.cs" />

    <!-- [XPLAT] (3d) Extracted section/zone state machine + machine-byte (PGN) assembler that consumes gated
         domain types. Services\SectionService.cs is the cross-platform extraction of the FormGPS
         Sections.Designer.cs partial (AAP §0.6.1); its DI ctor is signature-correct against the REAL
         collaborators (CSection/CModuleComm/CSound + the Core ApplicationModel already compile), but it also
         injects CTool (mf.tool), CTram (mf.tram) and CTrack (mf.trk) — all gated in (2) above — plus the
         still-gated PgnDispatcher (3c) for the shared p_254/p_239/p_229 PGN instances. It is therefore excluded
         in lockstep to preserve the "no compiling consumer of an excluded file" invariant — exactly as
         PgnDispatcher (3c) / FormNudgeView / FormFieldISOXMLView (which also inject CTrack/CTool) are handled
         above. No compiling source constructs SectionService (verified by reference scan — only doc comments in
         PgnDispatcher reference it), so this is a clean cut. The file itself is fully validated (frozen behavior:
         byte-exact BuildMachineByte for both sections-not-zones and zones modes, PGN 0xFE/0xEF/0xE5 bytes,
         MidpointRounding.AwayFromZero geometry, isJobStarted-gated DoRemoteSwitches) under both net8.0 and
         net8.0-windows. Re-enabled alongside CTool/CTram/CTrack + PgnDispatcher when they land and the
         composition root (App.axaml.cs) wires the PgnDispatcher<->PositionService/SectionService late-bound
         cycle (AAP §0.6.1). See MIGRATION_DOCS/TRANSITION_MAP.md. -->
    <Compile Remove="Services\SectionService.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- [XPLAT] FormFieldDataView's and FormFieldKMLView's markup is excluded in lockstep with their
         gated code-behind (above): remove each from BOTH the Avalonia XAML compilation and the embedded
         resource set so the AvaloniaResource glob (Views/**/*.axaml) does not try to compile a view whose
         code-behind partial is absent. Each is re-enabled with its .axaml.cs when CFieldData/CBoundary land. -->
    <AvaloniaXaml Remove="Views\Field\FormFieldDataView.axaml" />
    <AvaloniaResource Remove="Views\Field\FormFieldDataView.axaml" />
    <AvaloniaXaml Remove="Views\Field\FormFieldKMLView.axaml" />
    <AvaloniaResource Remove="Views\Field\FormFieldKMLView.axaml" />
    <!-- [XPLAT] FormFieldISOXMLView's markup is likewise excluded in lockstep with its gated code-behind
         (above): the compiled-XAML loader generates the InitializeComponent partial against the
         code-behind class, so the markup must leave BOTH the XAML compilation and the embedded resource
         set while the code-behind is gated. Re-enabled with FormFieldISOXMLView.axaml.cs when
         CBoundary/CFieldData/CTrack land. -->
    <AvaloniaXaml Remove="Views\Field\FormFieldISOXMLView.axaml" />
    <AvaloniaResource Remove="Views\Field\FormFieldISOXMLView.axaml" />
    <!-- [XPLAT] FormBoundaryPlayerView's markup is excluded in lockstep with its gated code-behind
         (above), which injects the deferred CBoundary domain model. Removed from BOTH the Avalonia XAML
         compilation and the embedded resource set so the AvaloniaResource glob does not compile a view
         whose code-behind is absent. Re-enabled with FormBoundaryPlayerView.axaml.cs when CBoundary lands. -->
    <AvaloniaXaml Remove="Views\Field\FormBoundaryPlayerView.axaml" />
    <AvaloniaResource Remove="Views\Field\FormBoundaryPlayerView.axaml" />
    <!-- [XPLAT] FormNudgeView's markup is excluded in lockstep with its gated code-behind (above):
         the compiled-XAML loader generates the InitializeComponent partial against the code-behind
         class, so the markup must leave BOTH the XAML compilation and the embedded resource set while
         the code-behind is gated. Re-enabled with FormNudgeView.axaml.cs when CTrack/CTool land. -->
    <AvaloniaXaml Remove="Views\Guidance\FormNudgeView.axaml" />
    <AvaloniaResource Remove="Views\Guidance\FormNudgeView.axaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
